<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DSH Launcher 实例守护进程
    - 由 DSH Launcher（dist\DSH Launcher.exe 同目录的 DSH Launcher.Watchdog.exe）作为子进程拉起
    - 职责：持有实例台账、探测实例存活、识别并转正 dshmarket 自重启产生的"幽灵实例"、
            清理实例残留（桌宠 electron / 市场重启 helper）、Launcher 退出/崩溃后收尾自灭
    - 生命周期严格受 Launcher 控制：Launcher 存活期间随行；Launcher 退出（正常/崩溃）即收尾退出
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DSH Launcher.Watchdog</AssemblyName>
    <RootNamespace>DshLauncher.Watchdog</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
