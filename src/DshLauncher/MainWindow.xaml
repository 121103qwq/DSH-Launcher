<Window x:Class="DshLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DSH Launcher"
        Icon="Assets/DSHLauncher.ico"
        Width="1180"
        Height="720"
        MinWidth="880"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Loaded="Window_OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            Background="{StaticResource PageBrush}"
            BorderBrush="#D6E4F1"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BlueBrush}"
                    CornerRadius="17,17,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="22,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="42"
                                Height="42"
                                Background="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                BorderThickness="0"
                                Padding="0"
                                Click="Brand_Click"
                                ToolTip="点击返回启动页">
                            <TextBlock Text="DSH"
                                       Foreground="{StaticResource BlueBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Margin="14,0,0,0"
                                   Text="DSH Launcher"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="NavigationHome" Tag="启动" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Margin="0,0,7,0" />
                                <TextBlock Text="启动" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationExtensions" Tag="扩展" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◇" Margin="0,0,7,0" />
                                <TextBlock Text="扩展" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationAgent" Tag="Agent" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" Margin="0,0,7,0" />
                                <TextBlock Text="Agent" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationConversations" Tag="对话" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☷" Margin="0,0,7,0" />
                                <TextBlock Text="对话" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationSettings" Tag="设置 / 诊断" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Margin="0,0,7,0" />
                                <TextBlock Text="设置 / 诊断" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Minimize_Click"
                                Width="42"
                                Height="42"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="White"
                                ToolTip="最小化">
                            <TextBlock Text="—" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Click="Close_Click"
                                Width="42"
                                Height="42"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="White"
                                ToolTip="关闭">
                            <TextBlock Text="×" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MainScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="18,16,18,24">
                        <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" />

                        <Border Visibility="{Binding PageNoticeVisibility}"
                                Background="#FFF4DF"
                                BorderBrush="#F1C26B"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,10"
                                Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PageNotice}"
                                           Foreground="#8B5A12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="查看详情"
                                        Visibility="{Binding PageNoticeDetailVisibility}"
                                        Click="ViewNoticeDetail_Click"
                                        Margin="12,0,0,0"
                                        Padding="10,4"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid x:Name="MainDashboardGrid" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProviderSummaryCard" Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="13" Padding="18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="ProviderHeaderGrid" Grid.Row="0">
                                        <StackPanel>
                                            <TextBlock Text="模型提供商" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ProviderSummaryText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Click="RefreshProviders_Click"
                                                    IsEnabled="{Binding CanRefreshProviders}"
                                                    Padding="8,4"
                                                    FontSize="11"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="↻" />
                                            </Button>
                                            <Border Background="#E7F1FC" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="离线配置" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="ProviderListGrid" Grid.Row="1" Margin="0,16,0,14">
                                        <TextBlock Text="未在当前实例的 settings.yaml 中检测到 llm Provider 配置；通过 DSh 登录页连接的 Provider 不会显示在这里。"
                                                   Visibility="{Binding NoProvidersVisibility}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" />
                                        <ScrollViewer Visibility="{Binding ProviderCardsVisibility}"
                                                      MaxHeight="300"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding ProviderCards}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F7FAFD"
                                                                CornerRadius="10"
                                                                Padding="11"
                                                                Margin="0,0,0,9">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Click="ProviderToggle_Click"
                                                                        ToolTip="{Binding ToggleToolTip}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="2"
                                                                        VerticalAlignment="Top">
                                                                    <Ellipse Width="15" Height="15" Fill="{Binding ToggleBrush}" />
                                                                </Button>
                                                                <StackPanel Grid.Column="1" Margin="9,0,7,0">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding ToggleStatusText}"
                                                                                   HorizontalAlignment="Right"
                                                                                   Foreground="{Binding ToggleBrush}"
                                                                                   FontSize="10" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding StatusText}"
                                                                               Foreground="{StaticResource BlueBrush}"
                                                                               FontSize="10"
                                                                               Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding DiagnosticSummary}"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding EndpointText}"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               FontSize="9"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,5,0,0" />
                                                                    <TextBlock Text="{Binding ModelCountText}"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               FontSize="9"
                                                                               Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding ThinkingText}"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               FontSize="9"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2"
                                                                        Click="ProviderIssue_Click"
                                                                        Visibility="{Binding IssueVisibility}"
                                                                        ToolTip="{Binding IssueToolTip}"
                                                                        Width="25"
                                                                        Height="25"
                                                                        Padding="0"
                                                                        Background="#FFF4DF"
                                                                        BorderBrush="#F1C26B"
                                                                        Foreground="#8B5A12">
                                                                    <TextBlock Text="?" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                    <Border x:Name="ProviderSeparator" Grid.Row="2" Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14" />
                                    <Grid Grid.Row="3">
                                        <TextBlock Text="启动实例" FontSize="16" FontWeight="SemiBold" />
                                        <Border HorizontalAlignment="Right" Background="#E7F1FC" CornerRadius="10" Padding="8,3">
                                            <TextBlock Text="{Binding InstanceCountText}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="4" Margin="0,14,0,14">
                                        <StackPanel VerticalAlignment="Center" Visibility="{Binding NoInstancesVisibility}">
                                            <Border Width="58" Height="58" Background="#EAF3FC" CornerRadius="18" HorizontalAlignment="Center">
                                                <TextBlock Text="＋" Foreground="{StaticResource BlueBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="尚未创建 DSh 版本"
                                                       HorizontalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Margin="0,16,0,0" />
                                            <TextBlock Text="点击下方“准备首个版本”，按引导准备运行环境并创建独立 DSH_HOME。"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontSize="12"
                                                       Margin="8,8,8,0" />
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding Instances}"
                                                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                                 Visibility="{Binding InstancesVisibility}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F5F9FD" CornerRadius="9" Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" Background="#DCECFB" CornerRadius="8">
                                                                <TextBlock Text="D" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DshVersionText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                                <TextBlock Text="{Binding ResourceSummaryText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                    <StackPanel Grid.Row="5" Margin="0,0,0,14">
                                        <TextBlock Text="{Binding SelectedInstanceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding InstanceEndpointText}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="StartInstance_Click"
                                                    IsEnabled="{Binding CanStartInstance}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Height="38"
                                                    Padding="14,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▶" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding StartInstanceButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="StopInstance_Click"
                                                    IsEnabled="{Binding CanStopInstance}"
                                                    Height="38"
                                                    Margin="8,0,0,0"
                                                    Padding="12,0">
                                                <TextBlock Text="停止" />
                                            </Button>
                                            <Button Click="RestartInstance_Click"
                                                    IsEnabled="{Binding CanRestartInstance}"
                                                    Height="38"
                                                    Margin="8,0,0,0"
                                                    Padding="12,0">
                                                <TextBlock Text="重启" />
                                            </Button>
                                            <Button Click="OpenDesktopShell_Click"
                                                    Visibility="{Binding DesktopShellVisibility}"
                                                    Height="38"
                                                    Margin="8,0,0,0"
                                                    Padding="12,0"
                                                    ToolTip="实验功能：使用当前版本的 DSH_HOME 打开 DSH Desktop 原生窗口">
                                                <TextBlock Text="桌面窗口" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6">
                                        <Button Click="VersionControl_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10">
                                            <TextBlock Text="版本控制" />
                                        </Button>
                                        <Button Click="VersionSettings_Click">
                                            <TextBlock Text="版本设置" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="InstanceWorkspacePanel" Grid.Column="2">
                                <Border Background="{StaticResource CardBrush}" CornerRadius="13" Padding="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="正在运行的实例" FontSize="18" FontWeight="SemiBold" />
                                            <Border Grid.Column="1" HorizontalAlignment="Right" Background="#E7F1FC" CornerRadius="10" Padding="8,3">
                                                <TextBlock Text="{Binding RunningInstanceCountText}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                            </Border>
                                        </Grid>
                                <TextBlock Grid.Row="2"
                                           Text="没有正在运行的实例。请从左侧选择实例并启动。"
                                                   Visibility="{Binding NoRunningInstancesVisibility}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,20,0,2" />
                                        <ListBox Grid.Row="2"
                                                 x:Name="RunningInstancesList"
                                                 ItemsSource="{Binding RunningInstances}"
                                                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                                 MouseDoubleClick="RunningInstances_MouseDoubleClick"
                                                 Visibility="{Binding RunningInstancesVisibility}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Margin="0,16,0,0"
                                                 MaxHeight="260"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F5F9FD" CornerRadius="9" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" Background="#E5F5EC" CornerRadius="8">
                                                                <TextBlock Text="●" Foreground="#25875A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="9,0,8,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding RuntimeOwnershipText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                                                <TextBlock Text="{Binding WebUrl}" Foreground="{StaticResource BlueBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="打开" Foreground="{StaticResource BlueBrush}" FontSize="11" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Grid>
                        <ContentControl x:Name="EmbeddedPageHost"
                                        Visibility="Collapsed"
                                        Margin="0,18,0,0"
                                        MinHeight="620"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.RowSpan="2" Panel.ZIndex="1000">
                <Thumb Tag="Left"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="6"
                       Margin="0,6,0,6"
                       HorizontalAlignment="Left"
                       Cursor="SizeWE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Right"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="6"
                       Margin="0,6,0,6"
                       HorizontalAlignment="Right"
                       Cursor="SizeWE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Top"
                       Style="{StaticResource ResizeThumbStyle}"
                       Height="6"
                       Margin="6,0,6,0"
                       VerticalAlignment="Top"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Bottom"
                       Style="{StaticResource ResizeThumbStyle}"
                       Height="6"
                       Margin="6,0,6,0"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="TopLeft"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="TopRight"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Cursor="SizeNESW"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="BottomLeft"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNESW"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="BottomRight"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta" />
            </Grid>

        </Grid>
    </Border>
</Window>
