<Window x:Class="DshLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DSH Launcher"
        Icon="Assets/DSHLauncher.ico"
        Width="1180"
        Height="720"
        MinWidth="880"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Loaded="Window_OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            Background="{StaticResource PageBrush}"
            BorderBrush="#D6E4F1"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BlueBrush}"
                    CornerRadius="17,17,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0,16,0">
                    <TextBlock x:Name="StartupBrandText"
                               Text="DSH Launcher"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    <Button x:Name="VersionSettingsBackButton"
                            Width="190"
                            Height="44"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Background="#2578C4"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="VersionSettingsBack_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BackChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="13,0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackChrome" Property="Background" Value="#3388D3" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BackChrome" Property="Background" Value="#1D69AF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="18" Margin="0,0,9,0" />
                            <TextBlock x:Name="VersionSettingsBackText"
                                       Text="返回"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="ContextInstanceSelector"
                            Width="190"
                            Height="44"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#2578C4"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Click="ContextInstanceSettings_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Padding="12,0"
                                    HorizontalContentAlignment="Left"
                                    ToolTip="打开当前实例的插件控制">
                                <TextBlock Text="{Binding SelectedInstanceName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Ellipse Grid.Column="1"
                                     Width="9"
                                     Height="9"
                                     Fill="{Binding SelectedInstanceStatusBrush}"
                                     ToolTip="{Binding SelectedInstanceStatus}" />
                            <Button Grid.Column="2"
                                    Width="38"
                                    Height="42"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Click="ContextInstanceMenu_Click"
                                    ToolTip="快速切换实例">
                                <TextBlock Text="⌄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="NavigationHome" Tag="启动" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Margin="0,0,7,0" />
                                <TextBlock Text="启动" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationDownloads" Tag="下载" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇩" Margin="0,0,7,0" />
                                <TextBlock Text="下载" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationExtensions" Tag="扩展" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◇" Margin="0,0,7,0" />
                                <TextBlock Text="扩展" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationAgent" Tag="Agent" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" Margin="0,0,7,0" />
                                <TextBlock Text="Agent" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationConversations" Tag="对话" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☷" Margin="0,0,7,0" />
                                <TextBlock Text="对话" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationProviders" Tag="Provider" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◎" Margin="0,0,7,0" />
                                <TextBlock Text="Provider" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationSettings" Tag="设置 / 诊断" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Margin="0,0,7,0" />
                                <TextBlock Text="设置 / 诊断" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Click="Minimize_Click"
                                Width="42"
                                Height="42"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="White"
                                ToolTip="最小化">
                            <TextBlock Text="—" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Click="Close_Click"
                                Width="42"
                                Height="42"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="White"
                                ToolTip="关闭">
                            <TextBlock Text="×" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MainScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="18,10,18,24">
                        <Border Visibility="{Binding PageNoticeVisibility}"
                                Background="#FFF4DF"
                                BorderBrush="#F1C26B"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,10"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PageNotice}"
                                           Foreground="#8B5A12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="查看详情"
                                        Visibility="{Binding PageNoticeDetailVisibility}"
                                        Click="ViewNoticeDetail_Click"
                                        Margin="12,0,0,0"
                                        Padding="10,4"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid x:Name="MainDashboardGrid" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource CardBrush}"
                                    CornerRadius="13"
                                    Padding="18"
                                    VerticalAlignment="Top"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="实例状态" FontSize="18" FontWeight="SemiBold" />
                                        <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="10" Padding="9,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding SelectedInstanceStatusBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding SelectedInstanceStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,22,0,0">
                                        <StackPanel VerticalAlignment="Center" Visibility="{Binding NoInstancesVisibility}">
                                            <Border Width="58" Height="58" Background="#EAF3FC" CornerRadius="18" HorizontalAlignment="Center">
                                                <TextBlock Text="＋" Foreground="{StaticResource BlueBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="尚未创建 DSh 版本"
                                                       HorizontalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Margin="0,16,0,0" />
                                            <TextBlock Text="点击下方“准备首个版本”，按引导准备运行环境并创建独立 DSH_HOME。"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontSize="12"
                                                       Margin="8,8,8,0" />
                                            <Button Click="StartInstance_Click"
                                                    IsEnabled="{Binding CanStartInstance}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,18,0,0"
                                                    Padding="18,9">
                                                <TextBlock Text="准备首个版本" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding InstancesVisibility}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SelectedInstanceName}"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SelectedInstanceSummary}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding InstanceEndpointText}"
                                                       Foreground="{StaticResource BlueBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                            <WrapPanel Margin="0,24,0,0">
                                                <Button Content="重命名"
                                                        Click="RenameSelectedInstance_Click"
                                                        Height="40"
                                                        Padding="15,0"
                                                        Margin="0,0,8,8" />
                                                <Button Content="实例设置"
                                                        Click="VersionSettings_Click"
                                                        Height="40"
                                                        Padding="15,0"
                                                        Margin="0,0,8,8" />
                                                <Button Click="StartInstance_Click"
                                                        IsEnabled="{Binding CanStartInstance}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Height="40"
                                                        Padding="15,0"
                                                        Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="▶" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding StartInstanceButtonText}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="Launcher 启动"
                                                        Click="StartLauncherInstance_Click"
                                                        Visibility="{Binding LauncherStartVisibility}"
                                                        IsEnabled="{Binding CanStartInstance}"
                                                        Height="40"
                                                        Padding="15,0"
                                                        Margin="0,0,8,8" />
                                                <Button Content="停止"
                                                        Click="StopInstance_Click"
                                                        IsEnabled="{Binding CanStopInstance}"
                                                        Height="40"
                                                        Padding="15,0"
                                                        Margin="0,0,8,8" />
                                                <Button Content="重启"
                                                        Click="RestartInstance_Click"
                                                        IsEnabled="{Binding CanRestartInstance}"
                                                        Height="40"
                                                        Padding="15,0"
                                                        Margin="0,0,8,8" />
                                                <Button Content="打开窗口"
                                                        Click="OpenDesktopShell_Click"
                                                        Visibility="{Binding DesktopShellVisibility}"
                                                        Height="40"
                                                        Padding="15,0"
                                                        Margin="0,0,8,8"
                                                        ToolTip="使用当前版本的 DSH_HOME 打开 DSH Desktop 原生窗口" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="InstanceWorkspacePanel"
                                    Grid.Column="2"
                                    Height="520"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource CardBrush}"
                                    CornerRadius="13"
                                    Padding="18"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="启动实例" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding InstanceCountText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="版本控制"
                                                    Click="VersionControl_Click"
                                                    Padding="11,6"
                                                    VerticalAlignment="Top" />
                                        </Grid>
                                        <ListBox Grid.Row="1"
                                                 x:Name="RunningInstancesList"
                                                 ItemsSource="{Binding Instances}"
                                                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                                 MouseDoubleClick="RunningInstances_MouseDoubleClick"
                                                 Visibility="{Binding InstancesVisibility}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Margin="0,18,0,0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F5F9FD" CornerRadius="9" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,0,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#96A3B5" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RuntimeStatus}" Value="Running">
                                                                                <Setter Property="Fill" Value="#2EA66B" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RuntimeStatus}" Value="Error">
                                                                                <Setter Property="Fill" Value="#D94A4A" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DshVersionText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                                                <TextBlock Text="{Binding ResourceSummaryText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                            </Border>
                        </Grid>
                        <ContentControl x:Name="EmbeddedPageHost"
                                        Visibility="Collapsed"
                                        Margin="0"
                                        MinHeight="620"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.RowSpan="2" Panel.ZIndex="1000">
                <Thumb Tag="Left"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="6"
                       Margin="0,6,0,6"
                       HorizontalAlignment="Left"
                       Cursor="SizeWE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Right"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="6"
                       Margin="0,6,0,6"
                       HorizontalAlignment="Right"
                       Cursor="SizeWE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Top"
                       Style="{StaticResource ResizeThumbStyle}"
                       Height="6"
                       Margin="6,0,6,0"
                       VerticalAlignment="Top"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Bottom"
                       Style="{StaticResource ResizeThumbStyle}"
                       Height="6"
                       Margin="6,0,6,0"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="TopLeft"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="TopRight"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Cursor="SizeNESW"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="BottomLeft"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNESW"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="BottomRight"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta" />
            </Grid>

        </Grid>
    </Border>
</Window>
