<Window x:Class="DshLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DSH Launcher"
        Icon="Assets/DSHLauncher.ico"
        Width="1180"
        Height="720"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Loaded="Window_OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TitleBarChromeBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TitleBarChromePressedBrush}" />
                            </Trigger>
                            <!-- 关闭按钮：Tag=Close，悬停红色警示（PCL 式） -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Close" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TitleBarCloseHoverBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="AppRootBorder"
            Margin="4"
            Background="{StaticResource PageBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{StaticResource TitleBarGradient}"
                    CornerRadius="17,17,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0,16,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Image Source="Assets/DSHLauncher.ico"
                               Width="22"
                               Height="22"
                               Margin="0,0,8,0" />
                        <TextBlock x:Name="StartupBrandText"
                                   Text="DSH Launcher"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="VersionSettingsBackButton"
                            Width="190"
                            Height="44"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Background="{StaticResource TitleBarChromeBrush}"
                            BorderBrush="{StaticResource TitleBarChromeBorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="VersionSettingsBack_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BackChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource PanelCornerRadius}">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="13,0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackChrome" Property="Background" Value="{StaticResource TitleBarChromeHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BackChrome" Property="Background" Value="{StaticResource TitleBarChromePressedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="18" Margin="0,0,9,0" />
                            <TextBlock x:Name="VersionSettingsBackText"
                                       Text="返回"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="ContextInstanceSelector"
                            Width="190"
                            Height="44"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource TitleBarChromeBrush}"
                            BorderBrush="{StaticResource TitleBarChromeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Click="ContextInstanceSettings_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Padding="12,0"
                                    HorizontalContentAlignment="Left"
                                    ToolTip="打开当前实例的插件控制">
                                <TextBlock Text="{Binding SelectedInstanceName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Ellipse Grid.Column="1"
                                     Width="9"
                                     Height="9"
                                     Fill="{Binding SelectedInstanceStatusBrush}"
                                     ToolTip="{Binding SelectedInstanceStatus}" />
                            <Button Grid.Column="2"
                                    Width="38"
                                    Height="42"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Click="ContextInstanceMenu_Click"
                                    ToolTip="快速切换实例">
                                <TextBlock Text="⌄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="NavigationHome" Tag="启动" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Margin="0,0,7,0" />
                                <TextBlock Text="启动" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationExtensions" Tag="扩展" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◇" Margin="0,0,7,0" />
                                <TextBlock Text="扩展" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationAgent" Tag="Agent" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" Margin="0,0,7,0" />
                                <TextBlock Text="Agent" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavigationConversations" Tag="对话" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☷" Margin="0,0,7,0" />
                                <TextBlock Text="对话" />
                            </StackPanel>
                        </Button>
                        <Grid>
                            <Button x:Name="NavigationTasks" Tag="任务" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⧗" Margin="0,0,7,0" />
                                    <TextBlock Text="任务" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="TaskBadge"
                                    Background="{StaticResource DangerBrush}"
                                    CornerRadius="8"
                                    MinWidth="16"
                                    Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-3,-3,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="TaskBadgeText"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="4,0" />
                            </Border>
                        </Grid>
                        <Button x:Name="NavigationSettings" Tag="设置 / 诊断" Click="Navigation_Click" Style="{StaticResource TopNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Margin="0,0,7,0" />
                                <TextBlock Text="设置 / 诊断" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Click="Minimize_Click"
                                Style="{StaticResource WindowControlButton}"
                                ToolTip="最小化">
                            <TextBlock Text="—" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Click="Maximize_Click"
                                Style="{StaticResource WindowControlButton}"
                                Width="34"
                                Height="34"
                                Margin="0,0,2,0"
                                ToolTip="最大化">
                            <TextBlock x:Name="MaximizeGlyph"
                                       Text="□"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Click="Close_Click"
                                Style="{StaticResource WindowControlButton}"
                                Tag="Close"
                                ToolTip="关闭">
                            <TextBlock Text="×" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                        <Border Visibility="{Binding PageNoticeVisibility}"
                                Background="{StaticResource WarningBackgroundBrush}"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,10"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PageNotice}"
                                           Foreground="{StaticResource WarningTextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="查看详情"
                                        Visibility="{Binding PageNoticeDetailVisibility}"
                                        Click="ViewNoticeDetail_Click"
                                        Margin="12,0,0,0"
                                        Padding="10,4"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid x:Name="MainDashboardGrid" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Top">
                                <!-- 阴影单独一层：避免 DropShadowEffect 把卡片内文字一起栅格化（小字发糊） -->
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        Effect="{StaticResource CardShadow}" />
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource CardPadding}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="实例状态" FontSize="18" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Visibility="{Binding SelectedInstanceSafeModeVisibility}"
                                                    Background="{StaticResource WarningBackgroundBrush}"
                                                    BorderBrush="{StaticResource WarningBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource PanelCornerRadius}"
                                                    Padding="9,3"
                                                    Margin="0,0,8,0"
                                                    ToolTip="当前实例存在隔离 profile（.dsh-safe）：启动时剥离了第三方插件，用户配置未被修改。"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True">
                                                <TextBlock Text="安全模式"
                                                           Foreground="{StaticResource WarningTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <Border Visibility="{Binding SelectedInstanceCooldownVisibility}"
                                                    Background="{StaticResource DangerSurfaceBrush}"
                                                    BorderBrush="{StaticResource DangerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource PanelCornerRadius}"
                                                    Padding="9,3"
                                                    Margin="0,0,8,0"
                                                    ToolTip="该实例连续崩溃后已转入冷却关闭：不再自动重启，崩溃现场已保留（实例设置 → 运行状况）。"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True">
                                                <TextBlock Text="崩溃冷却"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <Border Visibility="{Binding SelectedInstanceUpdateVisibility}"
                                                    Background="{StaticResource InfoBackgroundBrush}"
                                                    BorderBrush="{StaticResource BlueBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource PanelCornerRadius}"
                                                    Padding="9,3"
                                                    Margin="0,0,8,0"
                                                    ToolTip="{Binding SelectedInstanceUpdateTooltip}"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True">
                                                <TextBlock Text="有新版本"
                                                           Foreground="{StaticResource BlueBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <Border Visibility="{Binding SelectedInstanceSurfaceVisibility}"
                                                    Background="{StaticResource InfoBackgroundBrush}"
                                                    BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource PanelCornerRadius}"
                                                    Padding="9,3"
                                                    Margin="0,0,8,0"
                                                    ToolTip="{Binding SelectedInstanceSurfaceTooltip}"
                                                    SnapsToDevicePixels="True"
                                                    UseLayoutRounding="True">
                                                <TextBlock Text="{Binding SelectedInstanceSurfaceText}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <Border HorizontalAlignment="Right"
                                                    Background="{Binding SelectedInstanceStatusBackgroundBrush}"
                                                    BorderBrush="{Binding SelectedInstanceStatusBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource PanelCornerRadius}"
                                                Padding="9,3"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding SelectedInstanceStatusBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding SelectedInstanceStatus}" Foreground="{Binding SelectedInstanceStatusTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <StackPanel VerticalAlignment="Center" Visibility="{Binding NoInstancesVisibility}">
                                            <Border Width="58" Height="58" Background="{StaticResource PageBrush}" CornerRadius="18" HorizontalAlignment="Center">
                                                <TextBlock Text="＋" Foreground="{StaticResource BlueBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="尚未创建 DSh 版本"
                                                       HorizontalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Margin="0,16,0,0" />
                                            <TextBlock Text="点击下方“准备首个版本”，按引导准备运行环境并创建独立 DSH_HOME。"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontSize="12"
                                                       Margin="8,8,8,0" />
                                            <Button Click="StartInstance_Click"
                                                    IsEnabled="{Binding CanStartInstance}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,18,0,0"
                                                    Padding="18,9">
                                                <TextBlock Text="准备首个版本" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding InstancesVisibility}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SelectedInstanceName}"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SelectedInstanceKindText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding SelectedInstanceProfileText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Style="{StaticResource PathCardToolTip}">
                                                        <StackPanel>
                                                            <TextBlock Text="dsh profile" FontWeight="SemiBold" FontSize="12" />
                                                            <TextBlock Text="该实例当前使用的 profile（$DSH_HOME/profiles/&lt;名&gt;）：决定加载哪些 bundle 与插件，也决定呈现面（终端 / 无界面等）。可在扩展页顶部或实例设置里切换。"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="360"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <Button x:Name="InstanceRootPathLink"
                                                    Style="{StaticResource PathLinkButton}"
                                                    Click="PathLink_Click"
                                                    Content="{Binding SelectedInstanceRootPathText}"
                                                    Tag="{Binding SelectedInstanceRootPath}"
                                                    Visibility="{Binding SelectedInstancePathVisibility}"
                                                    Margin="0,4,0,0">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource PathCardToolTip}">
                                                        <StackPanel>
                                                            <TextBlock Text="实例目录" FontWeight="SemiBold" FontSize="12" />
                                                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="380"
                                                                       Margin="0,4,0,0" />
                                                            <TextBlock Text="点击即可复制"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,8,0,0" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                            <Button x:Name="InstanceDshHomeLink"
                                                    Style="{StaticResource PathLinkButton}"
                                                    Click="PathLink_Click"
                                                    Content="{Binding SelectedInstanceDshHomeText}"
                                                    Tag="{Binding SelectedInstanceDshHome}"
                                                    Visibility="{Binding SelectedInstancePathVisibility}"
                                                    Margin="0,3,0,0">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource PathCardToolTip}">
                                                        <StackPanel>
                                                            <TextBlock Text="DSH_HOME" FontWeight="SemiBold" FontSize="12" />
                                                            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="380"
                                                                       Margin="0,4,0,0" />
                                                            <TextBlock Text="点击即可复制"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,8,0,0" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                            <TextBlock Text="{Binding InstanceEndpointText}"
                                                       Foreground="{StaticResource BlueBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding SelectedInstanceResourceText}"
                                                       Visibility="{Binding SelectedInstanceResourceVisibility}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding BalanceText}"
                                                       Visibility="{Binding BalanceVisibility}"
                                                       ToolTip="{Binding BalanceDetailText}"
                                                       Foreground="{Binding BalanceForeground}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                            <StackPanel Margin="0,24,0,0">
                                                <!-- 启动：切分按钮（左＝按当前设置的方式启动；右＝切换启动方式）。设计见 work-log/81 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Click="StartInstance_Click"
                                                            IsEnabled="{Binding CanStartInstance}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Height="40"
                                                            Padding="15,0"
                                                            HorizontalAlignment="Stretch"
                                                            Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="▶" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding StartInstanceButtonText}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            x:Name="LaunchModeMenuButton"
                                                            Click="LaunchModeMenu_Click"
                                                            Content="▾"
                                                            Width="40"
                                                            Height="40"
                                                            Padding="0"
                                                            ToolTip="选择启动方式">
                                                        <Button.ContextMenu>
                                                            <ContextMenu Style="{StaticResource ContextInstanceMenuStyle}"
                                                                         Opened="LaunchModeMenu_Opened">
                                                                <MenuItem Header="Desktop 启动（启动器内部窗口）"
                                                                          Tag="Desktop"
                                                                          IsCheckable="True"
                                                                          Click="LaunchModeMenuItem_Click" />
                                                                <MenuItem Header="Web 启动（浏览器）"
                                                                          Tag="Web"
                                                                          IsCheckable="True"
                                                                          Click="LaunchModeMenuItem_Click" />
                                                                <MenuItem Header="打开窗口（DSH Desktop 封装）"
                                                                          Tag="ElectronDesktop"
                                                                          ToolTipService.ShowOnDisabled="True"
                                                                          Click="OpenDesktopShell_Click" />
                                                                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                                                <MenuItem Header="隔离启动（剥离第三方插件）"
                                                                          Tag="Isolated"
                                                                          IsCheckable="True"
                                                                          Click="LaunchModeMenuItem_Click" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </Grid>
                                                <!-- 停止 / 重启：均分 -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="停止"
                                                            Click="StopInstance_Click"
                                                            IsEnabled="{Binding CanStopInstance}"
                                                            Height="40"
                                                            Padding="15,0"
                                                            Margin="0,0,6,0" />
                                                    <Button Grid.Column="1"
                                                            Content="重启"
                                                            Click="RestartInstance_Click"
                                                            IsEnabled="{Binding CanRestartInstance}"
                                                            Height="40"
                                                            Padding="15,0"
                                                            Margin="6,0,0,0" />
                                                </Grid>
                                                <!-- 重命名 / 实例设置（按用户要求下一步移到卡片右侧） -->
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="重命名"
                                                            Click="RenameSelectedInstance_Click"
                                                            Height="40"
                                                            Padding="15,0"
                                                            Margin="0,0,6,0" />
                                                    <Button Grid.Column="1"
                                                            Content="实例设置"
                                                            Click="VersionSettings_Click"
                                                            Height="40"
                                                            Padding="15,0"
                                                            Margin="6,0,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="2">
                                <!-- 阴影单独一层：避免 DropShadowEffect 把卡片内文字一起栅格化 -->
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        Effect="{StaticResource CardShadow}" />
                                <Border x:Name="InstanceWorkspacePanel"
                                        Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        ClipToBounds="True"
                                        Padding="{StaticResource CardPadding}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="启动实例" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding InstanceCountText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="版本控制"
                                                    Click="VersionControl_Click"
                                                    Padding="11,6"
                                                    VerticalAlignment="Top" />
                                        </Grid>
                                        <ListBox Grid.Row="1"
                                                 x:Name="RunningInstancesList"
                                                 ItemsSource="{Binding Instances}"
                                                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                                 MouseDoubleClick="RunningInstances_MouseDoubleClick"
                                                 Visibility="{Binding InstancesVisibility}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Margin="0,14,0,0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InfoBackgroundBrush}" CornerRadius="9" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,0,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{StaticResource StatusIdleBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RuntimeStatus}" Value="Running">
                                                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RuntimeStatus}" Value="Error">
                                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DshVersionText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                                                <TextBlock Text="{Binding ResourceSummaryText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <!-- 无实例引导（右栏空态，PCL 式插画） -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoInstancesVisibility}" Margin="0,26,0,0">
                                            <Grid Width="170" Height="112">
                                                <Ellipse Width="112" Height="112" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{StaticResource EmptyStateGradientStartColor}" Offset="0" />
                                                            <GradientStop Color="{StaticResource EmptyStateGradientEndColor}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Ellipse Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource EmptyStateAccentBrush}" Margin="8,0,16,10" />
                                                <Ellipse Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{StaticResource EmptyStateAccentSoftBrush}" Margin="30,0,0,2" />
                                                <Path Data="M 8,0 L 8,58 L 78,58" Stroke="White" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0" Opacity="0.92" />
                                                <TextBlock Text="DSH" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,16,0" Opacity="0.95" />
                                            </Grid>
                                            <TextBlock Text="启动后的实例与运行状态会显示在这里"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       Margin="0,22,0,0" />
                                            <TextBlock Text="在左侧准备或导入一个 DSh 版本后即可启动"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <ContentControl x:Name="EmbeddedPageHost"
                                        Grid.Row="1"
                                        Visibility="Collapsed"
                                        Margin="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </Grid>

            <Grid Grid.RowSpan="2" Panel.ZIndex="1000">
                <Thumb Tag="Left"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="6"
                       Margin="0,6,0,6"
                       HorizontalAlignment="Left"
                       Cursor="SizeWE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Right"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="6"
                       Margin="0,6,0,6"
                       HorizontalAlignment="Right"
                       Cursor="SizeWE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Top"
                       Style="{StaticResource ResizeThumbStyle}"
                       Height="6"
                       Margin="6,0,6,0"
                       VerticalAlignment="Top"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="Bottom"
                       Style="{StaticResource ResizeThumbStyle}"
                       Height="6"
                       Margin="6,0,6,0"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="TopLeft"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="TopRight"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Cursor="SizeNESW"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="BottomLeft"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNESW"
                       DragDelta="ResizeThumb_DragDelta" />
                <Thumb Tag="BottomRight"
                       Style="{StaticResource ResizeThumbStyle}"
                       Width="10"
                       Height="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta" />
            </Grid>

        </Grid>
    </Border>
</Window>
