<UserControl x:Class="DshLauncher.ExtensionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Loaded="Window_OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="PageHeaderText" Text="扩展中心" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="InstanceText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,20,0,14">
            <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" />
            <Button x:Name="InstallPluginButton" Content="安装 / 更新 Plugin" Click="InstallPlugin_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button x:Name="ImportSkillButton" Content="导入 Skill" Click="ImportSkill_Click" Margin="0,0,8,0" />
            <Button x:Name="AddMcpButton" Content="添加 MCP" Click="AddMcp_Click" Margin="0,0,8,0" />
            <Button x:Name="ImportPresetButton" Content="导入 Agent Preset" Click="ImportPreset_Click" />
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Background="White" Padding="8">
                <ListBox x:Name="ExtensionList" BorderThickness="0" SelectionChanged="ExtensionList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,6" Background="#F6F9FC" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Enabled}" Foreground="#25875A" VerticalAlignment="Center" Margin="10,0,4,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="当前选择" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedName" FontSize="15" Margin="0,16,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="SelectedDetails" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Separator Margin="0,18,0,18" />
                    <Button x:Name="EnableButton" Content="启用" Click="Enable_Click" Margin="0,0,0,8" />
                    <Button x:Name="DisableButton" Content="禁用" Click="Disable_Click" Margin="0,0,0,8" />
                    <Button x:Name="UpdateButton" Content="更新当前 Plugin" Click="Update_Click" Margin="0,0,0,8" />
                    <Button x:Name="RemoveButton" Content="删除当前条目" Click="Remove_Click" />
                    <TextBlock x:Name="HintText" Text="修改前请停止实例。Plugin 和 MCP 会在下次启动时生效。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
    </Grid>
</UserControl>
