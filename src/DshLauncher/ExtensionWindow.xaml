<UserControl x:Class="DshLauncher.ExtensionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="Window_OnLoaded">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="InstalledPanel"
                Grid.Column="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="当前实例" FontSize="17" FontWeight="SemiBold" />
                    <ComboBox x:Name="InstanceSelectorBox"
                              Margin="0,10,0,0"
                              Visibility="Collapsed"
                              DisplayMemberPath="Name"
                              SelectionChanged="InstanceSelector_SelectionChanged" />
                    <TextBlock x:Name="CurrentInstanceNameText"
                               Foreground="{StaticResource BlueBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,10,0,0" />
                    <TextBlock x:Name="CurrentInstanceDetailsText"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,16,0,10">
                    <Button Content="刷新" Click="Refresh_Click" Margin="0,0,7,7" Padding="12,7" />
                    <Button x:Name="InstallPluginButton"
                            Content="手动安装 Plugin"
                            Click="InstallPlugin_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,7,7"
                            Padding="12,7" />
                    <Button x:Name="ImportSkillButton"
                            Content="导入 Skill"
                            Click="ImportSkill_Click"
                            Margin="0,0,7,7"
                            Padding="12,7" />
                    <Button x:Name="AddMcpButton"
                            Content="添加 MCP"
                            Click="AddMcp_Click"
                            Margin="0,0,7,7"
                            Padding="12,7" />
                    <Button x:Name="ImportPresetButton"
                            Content="导入 Agent Preset"
                            Click="ImportPreset_Click"
                            Margin="0,0,7,7"
                            Padding="12,7" />
                </WrapPanel>

                <Border Grid.Row="2"
                        Background="#F8FBFE"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8">
                    <ListBox x:Name="ExtensionList"
                             MaxHeight="620"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             SelectionChanged="ExtensionList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Margin="0,0,0,6"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}"
                                                   Foreground="{StaticResource BlueBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description, TargetNullValue=没有描述}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Enabled}"
                                                   Foreground="#25875A"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Row="3"
                        Background="#F5F9FD"
                        CornerRadius="9"
                        Padding="12"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="当前选择" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedName"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="SelectedDetails"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="EnableButton" Content="启用" Click="Enable_Click" Margin="0,0,6,6" Padding="10,6" />
                            <Button x:Name="DisableButton" Content="禁用" Click="Disable_Click" Margin="0,0,6,6" Padding="10,6" />
                            <Button x:Name="UpdateButton" Content="更新" Click="Update_Click" Margin="0,0,6,6" Padding="10,6" />
                            <Button x:Name="RemoveButton" Content="删除" Click="Remove_Click" Margin="0,0,6,6" Padding="10,6" />
                        </WrapPanel>
                        <TextBlock x:Name="HintText"
                                   Text="修改前请停止实例。Plugin 和 MCP 会在下次启动时生效。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4"
                           x:Name="StatusText"
                           Foreground="{StaticResource BlueBrush}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </Grid>
        </Border>

        <Border x:Name="MarketplacePanel"
                Grid.Column="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MarketplaceSearchBox"
                             Height="38"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             ToolTip="输入插件名称、包名或关键词"
                             TextChanged="MarketplaceSearchBox_TextChanged" />
                    <Button Grid.Column="1"
                            x:Name="MarketplaceRefreshButton"
                            Content="刷新目录"
                            Click="MarketplaceRefresh_Click"
                            Margin="8,0,0,0" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分类"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ListBox Grid.Column="1"
                                 x:Name="MarketplaceCategoryList"
                                 Height="34"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectedIndex="0"
                                 SelectionChanged="MarketplaceFilter_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F0FD" />
                                            <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBoxItem Tag="">全部</ListBoxItem>
                            <ListBoxItem Tag="UI">UI</ListBoxItem>
                            <ListBoxItem Tag="工具">工具</ListBoxItem>
                            <ListBoxItem Tag="工作流">工作流</ListBoxItem>
                            <ListBoxItem Tag="Agent">Agent</ListBoxItem>
                            <ListBoxItem Tag="模型">模型</ListBoxItem>
                            <ListBoxItem Tag="主题">主题</ListBoxItem>
                            <ListBoxItem Tag="开发">开发</ListBoxItem>
                        </ListBox>
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBlock Text="排序"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="MarketplaceSortBox"
                                  Width="148"
                                  Height="38"
                                  SelectedIndex="0"
                                  ToolTip="排序方式"
                                  SelectionChanged="MarketplaceFilter_SelectionChanged">
                            <ComboBoxItem Tag="Relevance">综合排序</ComboBoxItem>
                            <ComboBoxItem Tag="PublishedAt">最新发布</ComboBoxItem>
                            <ComboBoxItem Tag="Stars">热门（Star）</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="来源"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="18,0,8,0" />
                        <ComboBox x:Name="MarketplaceSourceBox"
                                  Width="168"
                                  Height="38"
                                  SelectedIndex="0"
                                  ToolTip="次级来源筛选"
                                  SelectionChanged="MarketplaceFilter_SelectionChanged">
                            <ComboBoxItem Tag="">全部来源</ComboBoxItem>
                            <ComboBoxItem Tag="Official">DSh 官方</ComboBoxItem>
                            <ComboBoxItem Tag="CommunityCatalog">社区目录</ComboBoxItem>
                            <ComboBoxItem Tag="GitHubTopic">GitHub 发现</ComboBoxItem>
                            <ComboBoxItem Tag="Custom">自定义目录</ComboBoxItem>
                        </ComboBox>
                    </WrapPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,14,0,12">
                    <TextBlock Text="插件市场" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="输入时直接在本地目录中筛选；只有点击“刷新目录”才会联网。安装前会再次检查 package.json 和 DSh bundle。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="MarketplaceSummaryText"
                               Foreground="{StaticResource BlueBrush}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="3"
                        Background="#F8FBFE"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8">
                    <ListBox x:Name="MarketplaceList"
                             MaxHeight="700"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             SelectionChanged="MarketplaceList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14"
                                        Margin="0,0,0,10"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36"
                                                Height="36"
                                                Background="#E2EFFB"
                                                CornerRadius="8"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="P"
                                                       Foreground="{StaticResource BlueBrush}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BlueBrush}"
                                                       TextDecorations="Underline"
                                                       Cursor="Hand"
                                                       ToolTip="打开插件 GitHub 仓库"
                                                       MouseLeftButtonUp="MarketplaceTitle_MouseLeftButtonUp"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TargetText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource BlueBrush}" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding VersionStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding VerificationText}" Foreground="#25875A" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding StarsText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding PublishedText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="预览"
                                                    Click="MarketplaceThemePreview_Click"
                                                    Padding="12,6"
                                                    Margin="0,0,0,7">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTheme}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{Binding ThemeActionText}"
                                                    Click="MarketplaceThemeApply_Click"
                                                    IsEnabled="{Binding ThemeCanApply}"
                                                    Padding="12,6"
                                                    Margin="0,0,0,7">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTheme}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{Binding ActionText}"
                                                    Click="MarketplaceAction_Click"
                                                    IsEnabled="{Binding CanAction}"
                                                    Padding="12,6"
                                                    Style="{StaticResource PrimaryButton}" />
                                            <Button Content="卸载"
                                                     Click="MarketplaceRemove_Click"
                                                     IsEnabled="{Binding CanRemove}"
                                                     Padding="12,6"
                                                     Margin="0,7,0,0" />
                                            <TextBlock Text="{Binding ThemeStatusText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,7,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTheme}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="4"
                            x:Name="MarketplaceProgressPanel"
                            Visibility="Collapsed"
                            Margin="0,10,0,0">
                    <TextBlock x:Name="MarketplaceProgressText"
                               Foreground="{StaticResource BlueBrush}"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="MarketplaceProgressBar"
                                 Height="7"
                                 Margin="0,6,0,0"
                                 IsIndeterminate="True" />
                </StackPanel>

                <TextBlock Grid.Row="5"
                           x:Name="MarketplaceStatusText"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </Grid>
        </Border>

        <Border x:Name="SkillMarketPanel"
                Grid.Column="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SkillMarketSearchBox"
                             Height="38"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             ToolTip="按 Skill 名称、仓库或描述筛选"
                             TextChanged="SkillMarketSearchBox_TextChanged" />
                    <Button Grid.Column="1"
                            x:Name="SkillMarketRefreshButton"
                            Content="刷新目录"
                            Click="SkillMarketRefresh_Click"
                            Margin="8,0,0,0" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,14,0,12">
                    <TextBlock Text="Skill 市场" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="从 GitHub 仓库中发现并校验单个 Skill；安装会导入所选 Skill 目录及配套文件（需实例已停止）。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,12">
                    <TextBlock Text="分类"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ListBox x:Name="SkillMarketCategoryList"
                             Height="34"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectedIndex="0"
                             SelectionChanged="SkillMarketCategoryList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F0FD" />
                                        <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Tag="">全部</ListBoxItem>
                        <ListBoxItem Tag="开发">开发</ListBoxItem>
                        <ListBoxItem Tag="设计">设计</ListBoxItem>
                        <ListBoxItem Tag="文档">文档</ListBoxItem>
                        <ListBoxItem Tag="效率">效率</ListBoxItem>
                        <ListBoxItem Tag="Agent">Agent</ListBoxItem>
                        <ListBoxItem Tag="其他">其他</ListBoxItem>
                    </ListBox>
                </StackPanel>

                <ListBox Grid.Row="3"
                         x:Name="SkillMarketList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    Margin="0,0,0,8"
                                    Background="#F7FAFD"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StarsText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Repository}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{StaticResource BlueBrush}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="安装"
                                                Click="SkillInstall_Click"
                                                Padding="14,7"
                                                IsEnabled="{Binding CanInstall}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4"
                           x:Name="SkillMarketStatusText"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
