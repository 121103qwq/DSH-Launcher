<UserControl x:Class="DshLauncher.ExtensionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="Window_OnLoaded">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="InstalledPanel"
                Grid.Column="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="当前实例" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentInstanceNameText"
                               Foreground="{StaticResource BlueBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,10,0,0" />
                    <TextBlock x:Name="CurrentInstanceDetailsText"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,16,0,10">
                    <Button Content="刷新" Click="Refresh_Click" Margin="0,0,7,7" Padding="12,7" />
                    <Button x:Name="InstallPluginButton"
                            Content="手动安装 Plugin"
                            Click="InstallPlugin_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,7,7"
                            Padding="12,7" />
                    <Button x:Name="ImportSkillButton"
                            Content="导入 Skill"
                            Click="ImportSkill_Click"
                            Margin="0,0,7,7"
                            Padding="12,7" />
                    <Button x:Name="AddMcpButton"
                            Content="添加 MCP"
                            Click="AddMcp_Click"
                            Margin="0,0,7,7"
                            Padding="12,7" />
                    <Button x:Name="ImportPresetButton"
                            Content="导入 Agent Preset"
                            Click="ImportPreset_Click"
                            Margin="0,0,7,7"
                            Padding="12,7" />
                </WrapPanel>

                <Border Grid.Row="2"
                        Background="#F8FBFE"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8">
                    <ListBox x:Name="ExtensionList"
                             MaxHeight="620"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             SelectionChanged="ExtensionList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Margin="0,0,0,6"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}"
                                                   Foreground="{StaticResource BlueBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description, TargetNullValue=没有描述}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Enabled}"
                                                   Foreground="#25875A"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Row="3"
                        Background="#F5F9FD"
                        CornerRadius="9"
                        Padding="12"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="当前选择" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedName"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="SelectedDetails"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="EnableButton" Content="启用" Click="Enable_Click" Margin="0,0,6,6" Padding="10,6" />
                            <Button x:Name="DisableButton" Content="禁用" Click="Disable_Click" Margin="0,0,6,6" Padding="10,6" />
                            <Button x:Name="UpdateButton" Content="更新" Click="Update_Click" Margin="0,0,6,6" Padding="10,6" />
                            <Button x:Name="RemoveButton" Content="删除" Click="Remove_Click" Margin="0,0,6,6" Padding="10,6" />
                        </WrapPanel>
                        <TextBlock x:Name="HintText"
                                   Text="修改前请停止实例。Plugin 和 MCP 会在下次启动时生效。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4"
                           x:Name="StatusText"
                           Foreground="{StaticResource BlueBrush}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </Grid>
        </Border>

        <Border x:Name="MarketplacePanel"
                Grid.Column="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MarketplaceSearchBox"
                             Height="38"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             ToolTip="输入插件名称、包名或关键词"
                             KeyDown="MarketplaceSearchBox_KeyDown" />
                    <ComboBox x:Name="MarketplaceSourceBox"
                              Grid.Column="1"
                              Height="38"
                              Margin="8,0,0,0"
                              SelectedIndex="0"
                              SelectionChanged="MarketplaceFilter_SelectionChanged">
                        <ComboBoxItem Tag="">全部来源</ComboBoxItem>
                        <ComboBoxItem Tag="Official">DSh 官方</ComboBoxItem>
                        <ComboBoxItem Tag="CommunityCatalog">社区目录</ComboBoxItem>
                        <ComboBoxItem Tag="GitHubTopic">GitHub 发现</ComboBoxItem>
                        <ComboBoxItem Tag="Custom">自定义目录</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="MarketplaceSortBox"
                              Grid.Column="2"
                              Height="38"
                              Margin="8,0,0,0"
                              SelectedIndex="0"
                              SelectionChanged="MarketplaceFilter_SelectionChanged">
                        <ComboBoxItem Tag="Relevance">默认排序</ComboBoxItem>
                        <ComboBoxItem Tag="PublishedAt">发布时间</ComboBoxItem>
                        <ComboBoxItem Tag="Stars">Star 数量</ComboBoxItem>
                    </ComboBox>
                    <Button Grid.Column="3"
                            Content="搜索"
                            Click="MarketplaceSearch_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" />
                    <Button Grid.Column="4"
                            Content="刷新目录"
                            Click="MarketplaceRefresh_Click"
                            Margin="8,0,0,0" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,14,0,12">
                    <TextBlock Text="插件市场" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="右侧显示市场候选；安装前会再次检查 package.json 和 DSh bundle。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="MarketplaceSummaryText"
                               Foreground="{StaticResource BlueBrush}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="#F8FBFE"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8">
                    <ListBox x:Name="MarketplaceList"
                             MaxHeight="700"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             SelectionChanged="MarketplaceList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14"
                                        Margin="0,0,0,10"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36"
                                                Height="36"
                                                Background="#E2EFFB"
                                                CornerRadius="8"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="P"
                                                       Foreground="{StaticResource BlueBrush}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TargetText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource BlueBrush}" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding VerificationText}" Foreground="#25875A" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding StarsText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding PublishedText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionText}"
                                                    Click="MarketplaceAction_Click"
                                                    IsEnabled="{Binding CanAction}"
                                                    Padding="12,6"
                                                    Style="{StaticResource PrimaryButton}" />
                                            <Button Content="卸载"
                                                    Click="MarketplaceRemove_Click"
                                                    IsEnabled="{Binding CanRemove}"
                                                    Padding="12,6"
                                                    Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Grid.Row="3"
                           x:Name="MarketplaceStatusText"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
