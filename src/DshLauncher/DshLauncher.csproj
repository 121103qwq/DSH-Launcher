<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DSH Launcher</AssemblyName>
    <RootNamespace>DshLauncher</RootNamespace>
    <ApplicationTitle>DSH Launcher</ApplicationTitle>
    <ApplicationIcon>Assets\DSHLauncher.ico</ApplicationIcon>
    <Version>1.0.7</Version>
    <FileVersion>1.0.7.0</FileVersion>
    <AssemblyVersion>1.0.7.0</AssemblyVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 发布形态：自包含单文件（内含 .NET 8 运行时，免安装/免管理员）。
         写在工程里，保证 `dotnet publish` 与 VS 发布都得到同样的可独立运行产物，
         不会误发成需要另装 .NET 8 Desktop Runtime 的多文件版本。 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\DSHLauncher.ico" />
    <None Remove="Assets\DeepSeek.ico" />
    <None Remove="Assets\DeepSeekOpenPlatform.ico" />
    <Resource Include="Assets\DSHLauncher.ico" />
    <Resource Include="Assets\DeepSeek.ico" />
    <Resource Include="Assets\DeepSeekOpenPlatform.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
