<UserControl x:Class="DshLauncher.ProviderManagementWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="Window_OnLoaded"
             Unloaded="Window_OnUnloaded">
    <Grid Margin="18" MinHeight="590">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="全局 Coding" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="统一管理所有 Coding 版本使用的 Provider。"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                </StackPanel>
                <Separator Grid.Row="1" Margin="0,18,0,14" />
                <StackPanel Grid.Row="2">
                    <TextBlock Text="筛选" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Button x:Name="AllProvidersFilter"
                            Tag="All"
                            Content="全部"
                            Click="ProviderFilter_Click"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            Margin="0,0,0,6" />
                    <Button Tag="Official"
                            Content="官方目录"
                            Click="ProviderFilter_Click"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            Margin="0,0,0,6" />
                    <Button Tag="Custom"
                            Content="自定义"
                            Click="ProviderFilter_Click"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            Margin="0,0,0,6" />
                    <Button Tag="Problem"
                            Content="需要处理"
                            Click="ProviderFilter_Click"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" />
                </StackPanel>
                <TextBlock Grid.Row="3"
                           Text="Provider 与凭据由全局 Coding 配置统一管理；会话仍可单独选择模型。"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="默认模型" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="用于没有单独会话或 DSh 工作区规则的新对话。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              x:Name="DefaultModelBox"
                              Height="38"
                              DisplayMemberPath="DisplayText"
                              HorizontalAlignment="Stretch" />
                    <Button Grid.Column="2"
                            Content="保存默认模型"
                            Click="SaveDefaultModel_Click"
                            Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            Padding="16,8" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,14,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProviderSearchBox"
                             Height="38"
                             TextChanged="ProviderSearch_TextChanged"
                             ToolTip="搜索 Provider 或模型" />
                    <Button Grid.Column="1"
                            Content="刷新"
                            Click="Refresh_Click"
                            Margin="10,0,0,0"
                            Padding="16,8" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8">
                <ListBox x:Name="ProviderList"
                         MaxHeight="620"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFCFE"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="15">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◎" Foreground="{StaticResource BlueBrush}" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ModelCountText}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <Border Background="#EAF3FC" CornerRadius="8" Padding="8,3" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding KindText}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="{Binding RuntimeStatusBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding RuntimeStatusText}" Foreground="{Binding RuntimeStatusBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding ProviderIdText}" Margin="28,10,0,0" />
                                    <TextBlock Text="{Binding BaseUrlText}" Foreground="{StaticResource MutedBrush}" Margin="28,5,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ConfigurationWarningText}" Foreground="#C56A00" Margin="28,5,0,0" />
                                    <ItemsControl ItemsSource="{Binding Models}" Margin="28,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#EEF5FC" CornerRadius="7" Padding="8,4" Margin="0,0,6,5">
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="3"
                       x:Name="StatusText"
                       Foreground="{StaticResource BlueBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />
        </Grid>
    </Grid>
</UserControl>
