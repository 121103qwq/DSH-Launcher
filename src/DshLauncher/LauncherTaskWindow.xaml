<UserControl SnapsToDevicePixels="True" UseLayoutRounding="True" x:Class="DshLauncher.LauncherTaskWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Loaded="Window_OnLoaded"
             Unloaded="Window_OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="任务中心" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Launcher 的长任务：运行环境准备（Node / DSh 安装与修复）、插件与技能操作、实例导入、更换运行版本。运行中的任务可以在这里取消（与原有进度窗的取消等效）；任务结束时写入 launcher-tasks.json，保留最近 50 条。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="刷新" Click="Refresh_Click" Padding="12,7" Margin="0,0,7,0" />
                        <Button x:Name="ClearHistoryButton" Content="清空历史" Click="ClearHistory_Click" Padding="12,7" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="RunningCountText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" />
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="{StaticResource CardPadding}">
                <Grid>
                    <ListView x:Name="TaskList"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" >
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding StartedText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding TargetText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding InstanceName}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                                    <TextBlock Grid.Column="4" Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Succeeded">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="5" Text="{Binding DurationText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SummaryText}" />
                                    <Button Grid.Column="7"
                                            Content="取消"
                                            Click="CancelTask_Click"
                                            Tag="{Binding Id}"
                                            IsEnabled="{Binding IsRunning}"
                                            Padding="10,4"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText"
                               Text="还没有任务记录：准备运行环境、安装插件、导入实例或更换运行版本之后，这里会留下台账。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
