<UserControl x:Class="DshLauncher.VersionControlWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Loaded="Window_OnLoaded"
             Unloaded="Window_OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="版本列表" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding VersionCountText}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                    </Grid>
                    <ListBox x:Name="VersionList"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                             MouseDoubleClick="VersionList_MouseDoubleClick"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="#F5F9FD" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F0FD" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=BorderBrush}"
                                        BorderThickness="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=BorderThickness}"
                                        CornerRadius="9"
                                        Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" Background="#DCECFB" CornerRadius="8">
                                            <TextBlock Text="D" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DshVersionText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ResourceSummaryText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Button x:Name="AddInstanceButton"
                                Content="导入实例"
                                Click="AddInstance_Click"
                                IsEnabled="{Binding CanAddInstance}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="从文件夹导入" Click="ScanInstanceFolder_Click" />
                                    <MenuItem Header="从快捷方式导入" Click="ScanInstanceShortcut_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="新建干净版本" Click="CreateCleanVersion_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                        <Button Content="导入整合包" Click="ImportPackage_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="版本控制" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="HintText"
                               Text="每个版本拥有独立 DSH_HOME；同一个 DSh 运行目录可以被多个版本共用。"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,22" />
                    <Border Background="#F5F9FD" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedVersionName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedVersionDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="检查版本"
                                        Click="CheckVersion_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="{Binding CanCheck}"
                                        Padding="16,9"
                                        Margin="0,0,8,8" />
                                <Button Content="修复可处理项"
                                        Click="RepairVersion_Click"
                                        IsEnabled="{Binding CanRepair}"
                                        Padding="16,9"
                                        Margin="0,0,8,8" />
                                <Button Content="复制版本"
                                        Click="CloneVersion_Click"
                                        IsEnabled="{Binding CanClone}"
                                        ToolTip="{Binding CloneButtonToolTip}"
                                        Padding="16,9"
                                        Margin="0,0,8,8" />
                                <Button Content="删除版本"
                                        Click="DeleteVersion_Click"
                                        IsEnabled="{Binding CanDelete}"
                                        ToolTip="{Binding DeleteButtonToolTip}"
                                        Foreground="#B42318"
                                        Padding="16,9"
                                        Margin="0,0,8,8" />
                                <Button Content="版本设置" Click="OpenSettings_Click" Padding="16,9" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F9FD"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="版本检查" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding HealthSummary}"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <ItemsControl ItemsSource="{Binding HealthItems}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="11"
                                                Margin="0,0,0,7">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="配置快照与回滚" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="保存版本设置、Provider 凭据、MCP 与 Plugin 配置；使用当前 Windows 用户加密，不包含会话和运行依赖。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Snapshots}"
                                          SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          MinWidth="260"
                                          Height="36" />
                                <Button Grid.Column="1"
                                        Content="创建快照"
                                        Click="CreateSnapshot_Click"
                                        IsEnabled="{Binding CanSnapshot}"
                                        Margin="8,0,0,0"
                                        Padding="14,8" />
                                <Button Grid.Column="2"
                                        Content="回滚选中快照"
                                        Click="RollbackSnapshot_Click"
                                        IsEnabled="{Binding CanRollback}"
                                        Margin="8,0,0,0"
                                        Padding="14,8" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF9EA" BorderBrush="#F1C26B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="整合包格式" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PackageFormatText}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="包内使用 manifest.json 和 dsh-home/ 目录。导入时会建立新的独立版本，不会覆盖当前版本。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource BlueBrush}" TextWrapping="Wrap" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
