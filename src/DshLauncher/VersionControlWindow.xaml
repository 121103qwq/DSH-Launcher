<UserControl SnapsToDevicePixels="True" UseLayoutRounding="True" x:Class="DshLauncher.VersionControlWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Loaded="Window_OnLoaded"
             Unloaded="Window_OnUnloaded">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <!-- 阴影单独一层：避免 DropShadowEffect 把列表文字一起栅格化 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Effect="{StaticResource CardShadowSoft}" />
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="版本列表" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding VersionCountText}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                    </Grid>
                    <ListBox x:Name="VersionList"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                             MouseDoubleClick="VersionList_MouseDoubleClick"
                             BorderThickness="0"
                             Background="Transparent" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource HighlightSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=BorderBrush}"
                                        BorderThickness="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=BorderThickness}"
                                        CornerRadius="{StaticResource PanelCornerRadius}"
                                        Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" Background="{StaticResource HighlightSurfaceBrush}" CornerRadius="{StaticResource ItemCornerRadius}">
                                            <TextBlock Text="D" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DshVersionText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ResourceSummaryText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BlueBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Button x:Name="AddInstanceButton"
                                Content="导入实例"
                                Click="AddInstance_Click"
                                IsEnabled="{Binding CanAddInstance}"
                                ToolTip="导入一个已有的 dsh 安装（文件夹 / 快捷方式 / 源码 / 本机环境扫描 / 整合包）。与「新建干净版本」的区别：新建是空实例，导入会沿用现有的安装目录与配置。"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8">
                            <Button.ContextMenu>
                                <!-- 变更集 140 修复：点击后只出现窄白框 —— 给弹出层定最小宽度，避免双行项在 popup 测量期宽度塔陷；
                                     Placement 在此显式指定，PlacementTarget 由 AddInstance_Click 在代码里设置
                                     （ContextMenu 不在按钮可视树内，用 RelativeSource AncestorType=Button 解析不到）。 -->
                                <ContextMenu Style="{StaticResource ContextInstanceMenuStyle}"
                                            MinWidth="320"
                                            Placement="Bottom">
                                    <!-- 双行菜单项（变更集 133）：标题 + 11px MutedBrush 说明。说明放在 Header 内容里，
                                         不覆写共享模板（避免复制一份悬停/选中/禁用触发器），也不新增任何字形。
                                         Header 不是字符串时 UIA Name 会为空，因此显式给 AutomationProperties.Name
                                         （既让 UI 自动化可用，也满足 §1.9 可访问性要求）。 -->
                                    <MenuItem Click="ScanInstanceFolder_Click" AutomationProperties.Name="从文件夹导入" Style="{StaticResource ContextInstanceMenuItemStyle}">
                                        <MenuItem.Header>
<StackPanel>
                                            <TextBlock Text="从文件夹导入" />
                                            <TextBlock Text="选一个含 dsh 的目录" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="ScanInstanceShortcut_Click" AutomationProperties.Name="从快捷方式导入" Style="{StaticResource ContextInstanceMenuItemStyle}">
                                        <MenuItem.Header>
<StackPanel>
                                            <TextBlock Text="从快捷方式导入" />
                                            <TextBlock Text="从 .lnk 解析出安装目录" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="ImportSourceProject_Click" AutomationProperties.Name="从源码目录导入" Style="{StaticResource ContextInstanceMenuItemStyle}">
                                        <MenuItem.Header>
<StackPanel>
                                            <TextBlock Text="从源码目录导入" />
                                            <TextBlock Text="选 dsh 源码仓库根目录" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="ScanEnvironment_Click" AutomationProperties.Name="扫描本机 DSH 环境" Style="{StaticResource ContextInstanceMenuItemStyle}">
                                        <MenuItem.Header>
<StackPanel>
                                            <TextBlock Text="扫描本机 DSH 环境" />
                                            <TextBlock Text="枚举 .dsh* 与 DSH_HOME 指向的 home" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                    <MenuItem Click="ImportPackage_Click" AutomationProperties.Name="导入整合包" Style="{StaticResource ContextInstanceMenuItemStyle}">
                                        <MenuItem.Header>
<StackPanel>
                                            <TextBlock Text="导入整合包" />
                                            <TextBlock Text=".dshpack / .dspack / .tgz：建一个独立版本" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="新建干净版本"
                                Click="CreateCleanVersion_Click"
                                IsEnabled="{Binding CanCreateVersion}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8" />
                    </StackPanel>
                </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                <StackPanel Margin="22">
                    <TextBlock Text="版本控制" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="HintText"
                               Text="每个版本拥有独立 DSH_HOME；同一个 DSh 运行目录可以被多个版本共用。"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,22" />
                    <Border Background="{StaticResource InfoBackgroundBrush}" CornerRadius="{StaticResource PanelCornerRadius}" Padding="{StaticResource PanelPadding}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedVersionName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedVersionDetails}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="检查版本"
                                        Click="CheckVersion_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="{Binding CanCheck}"
                                        Padding="16,9"
                                        Margin="0,0,8,8" />
                                <Button Content="修复可处理项"
                                        Click="RepairVersion_Click"
                                        IsEnabled="{Binding CanRepair}"
                                        Padding="16,9"
                                        Margin="0,0,8,8" />
                                <Button Content="复制版本"
                                        Click="CloneVersion_Click"
                                        IsEnabled="{Binding CanClone}"
                                        ToolTip="{Binding CloneButtonToolTip}"
                                        Padding="16,9"
                                        Margin="0,0,8,8" />
                                <Button Style="{StaticResource DangerButton}" Content="删除版本"
                                        Click="DeleteVersion_Click"
                                        IsEnabled="{Binding CanDelete}"
                                        ToolTip="{Binding DeleteButtonToolTip}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Padding="16,9"
                                        Margin="0,0,8,8" />
                                <Button Content="版本设置" Click="OpenSettings_Click" Padding="16,9" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource InfoBackgroundBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            Padding="{StaticResource PanelPadding}"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="版本检查" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding HealthSummary}"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <ItemsControl ItemsSource="{Binding HealthItems}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ItemCornerRadius}"
                                                Padding="11"
                                                Margin="0,0,0,7">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- 运行版本（变更集 79：从「实例设置 → 版本与快照」页合并到这里） -->
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            Padding="{StaticResource PanelPadding}"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="运行版本" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock x:Name="RuntimeVersionText"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="SwitchVersionButton"
                                            Content="更换运行版本"
                                            Click="SwitchVersion_Click"
                                            IsEnabled="{Binding CanSwitchVersion}"
                                            Padding="14,8" />
                                    <Button x:Name="RollbackVersionButton"
                                            Content="回退到上一版本"
                                            Click="RollbackVersion_Click"
                                            IsEnabled="{Binding CanRollbackVersion}"
                                            Padding="14,8"
                                            Margin="0,8,0,0"
                                            ToolTip="用上一条切换历史的起点版本预选切换向导（仍需检查与确认，不会静默切换）。" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="CheckDshUpdatesBox"
                                      Content="显示 DSh 版本更新提示（联网查询官方版本，含预发布）"
                                      Click="CheckDshUpdates_Click"
                                      Margin="0,12,0,0" />
                            <TextBlock x:Name="DshUpdateHintText"
                                       Foreground="{StaticResource BlueBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="更换运行版本只改 dsh 运行程序与启动入口，保留该版本的 DSH_HOME（配置 / 插件 / 会话）；降级前建议先导出现有会话备份。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            Padding="{StaticResource PanelPadding}"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="切换历史" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="只记录由本启动器完成的更换（时间、前→后版本、是否建快照/导出会话）。「回退到上一版本」把上一条历史的起点版本预选进切换向导，仍需你检查并确认。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <ListBox x:Name="SwitchHistoryList"
                                     Height="110"
                                     Margin="0,10,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" />
                            <TextBlock x:Name="SwitchHistoryStatusText"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            Padding="{StaticResource PanelPadding}"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="配置快照与回滚" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="保存版本设置、Provider 凭据、MCP 与 Plugin 配置；使用当前 Windows 用户加密，不包含会话和运行依赖。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Snapshots}"
                                          SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          MinWidth="260"
                                          Height="36" />
                                <Button Grid.Column="1"
                                        Content="创建快照"
                                        Click="CreateSnapshot_Click"
                                        IsEnabled="{Binding CanSnapshot}"
                                        Margin="8,0,0,0"
                                        Padding="14,8" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource DangerButton}" Content="回滚选中快照"
                                        Click="RollbackSnapshot_Click"
                                        IsEnabled="{Binding CanRollback}"
                                        Margin="8,0,0,0"
                                        Padding="14,8" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="{StaticResource PanelCornerRadius}" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="整合包格式" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PackageFormatText}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="包内使用 manifest.json 和 dsh-home/ 目录。导入时会建立新的独立版本，不会覆盖当前版本。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource BlueBrush}" TextWrapping="Wrap" Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
</UserControl>
