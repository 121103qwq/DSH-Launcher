<Application x:Class="DshLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
        <!-- 蓝系：PCL 式 10 级渐变体系（#0b5bcb→#1370f3→#4890f5→…→#eaf2fe） -->
        <SolidColorBrush x:Key="BlueBrush" Color="#1370F3" />
        <SolidColorBrush x:Key="BlueDarkBrush" Color="#0B5BCB" />
        <SolidColorBrush x:Key="PageBrush" Color="#EAF2FE" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#343D4A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8C8C8C" />
        <SolidColorBrush x:Key="LineBrush" Color="#D5E6FD" />
        <SolidColorBrush x:Key="GreenBrush" Color="#2EA66B" />

        <!-- 语义色（开发历史中散落的硬编码收敛于此）：状态/危险/警告/信息底 -->
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#25875A" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#A25A54" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
        <SolidColorBrush x:Key="DangerStrongBrush" Color="#8F1C12" />   <!-- 危险操作悬停时的描边加深（变更集 140） -->
        <SolidColorBrush x:Key="WarningBrush" Color="#F1C26B" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#8A6D1B" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF9EA" />
        <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#F5F9FD" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F8FBFE" />
        <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#F7FAFD" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#E0EAFD" />   <!-- 菜单项悬停底（变更集 131） -->
        <!-- 变更集 132（A2 颜色令牌化收尾）：样式/模板里原以字面量写死的颜色 -->
        <Color x:Key="BlueColor">#1370F3</Color>
        <Color x:Key="BlueDarkColor">#0B5BCB</Color>
        <Color x:Key="ShadowColor">#3E5C7A</Color>
        <SolidColorBrush x:Key="OnBrandTextBrush" Color="#FFFFFF" />        <!-- 品牌蓝底上的文字/描边 -->
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#C5D5E6" />      <!-- 输入类控件描边 -->
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#E7F1FC" />      <!-- 次级浅蓝面（禁用/选中/进度底） -->
        <SolidColorBrush x:Key="SelectionBrush" Color="#B8DCF8" />          <!-- 文本选择高亮 -->
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C8D8EA" />        <!-- 滚动条滑块（常态/悬停/拖动） -->
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#96C0F9" />
        <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#4890F5" />
        <SolidColorBrush x:Key="StatusOkSoftBrush" Color="#342EA66B" />     <!-- 状态胶囊底（≈15% 绿/红/灰） -->
        <SolidColorBrush x:Key="StatusErrorSoftBrush" Color="#34D94A4A" />
        <SolidColorBrush x:Key="StatusIdleSoftBrush" Color="#2C96A3B5" />
        <SolidColorBrush x:Key="StatusOkTextBrush" Color="#1F7A50" />       <!-- 状态胶囊文字（深色调） -->
        <SolidColorBrush x:Key="StatusIdleTextBrush" Color="#606B7A" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#6A3D9A" />       <!-- TUI/home 来源标签 -->

        <!-- 标题栏 chrome（原 MainWindow 里散落的白色叠加） -->
        <SolidColorBrush x:Key="TitleBarChromeBrush" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="TitleBarChromeBorderBrush" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="TitleBarChromeHoverBrush" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="TitleBarChromePressedBrush" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#CE2111" />

        <!-- 语义面（原散落各页的浅色底/描边） -->
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FEF3F2" />
        <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E7F6EC" />
        <SolidColorBrush x:Key="SuccessBorderBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#F4F8FC" />
        <SolidColorBrush x:Key="HighlightSurfaceBrush" Color="#E3F0FD" />
        <SolidColorBrush x:Key="NeutralSurfaceBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="StatusIdleBrush" Color="#96A3B5" />

        <!-- 空态插画（MainWindow 无实例引导；GradientStop 需要 Color 类型） -->
        <Color x:Key="EmptyStateGradientStartColor">#4890F5</Color>
        <Color x:Key="EmptyStateGradientEndColor">#96C0F9</Color>
        <SolidColorBrush x:Key="EmptyStateAccentBrush" Color="#7FB2F9" />
        <SolidColorBrush x:Key="EmptyStateAccentSoftBrush" Color="#C6DCFC" />

        <!-- 圆角/间距 token（规范见 docs/UI-DESIGN.md） -->
        <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="PanelCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="ItemCornerRadius">8</CornerRadius>
        <Thickness x:Key="CardPadding">18</Thickness>
        <Thickness x:Key="PanelPadding">16</Thickness>
        <Thickness x:Key="ItemMargin">0,0,0,8</Thickness>
        <Thickness x:Key="IconTextGap">0,0,8,0</Thickness>   <!-- 图标在文字**之前**时的间距（变更集 130） -->
        <Thickness x:Key="IconTextGapTrailing">8,0,0,0</Thickness>   <!-- 图标在文字**之后**时的间距（变更集 148，如「中文官网 ↗」） -->
        <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource BlueDarkColor}" Offset="0" />
            <GradientStop Color="{StaticResource BlueColor}" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow" Color="{StaticResource ShadowColor}" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14" />
        <DropShadowEffect x:Key="CardShadowSoft" Color="{StaticResource ShadowColor}" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.08" />

        <!-- 文本渲染：Display/ClearType（WPF 默认 Ideal 在高 DPI 下发虚）；
             布局取整避免亚像素错位。应用到所有 Window 与嵌入 UserControl。 -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        </Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        </Style>

        <!-- PCL 式细滚动条：无箭头、圆角 thumb、透明轨道（全局生效） -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbChrome" Background="{StaticResource ScrollThumbBrush}" CornerRadius="5" Margin="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource ScrollThumbDragBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContextInstanceMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxHeight" Value="410" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6"
                                ClipToBounds="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 菜单分隔线：默认模板不吃 Background/Margin（实测会出现"白线左右顶满"），
             所以自带模板自绘 1px 线；做成 keyed 样式以便在弹出层里显式引用。 -->
        <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="{StaticResource LineBrush}"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator" BasedOn="{StaticResource MenuSeparatorStyle}" />
        <Style x:Key="ContextInstanceMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource PageBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 危险菜单项（变更集 131）：只把前景改为危险色，悬停底仍用中性 MenuHoverBrush -->
        <Style x:Key="MenuItemDangerStyle" TargetType="MenuItem" BasedOn="{StaticResource ContextInstanceMenuItemStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
        </Style>
        <!-- 隐式样式：所有菜单项默认走统一外观（变更集 131；此前 MainWindow 分体菜单未挂样式→系统默认外观） -->
        <Style TargetType="MenuItem" BasedOn="{StaticResource ContextInstanceMenuItemStyle}" />
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxHitTarget" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Chrome"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <ContentPresenter x:Name="SelectionPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="{TemplateBinding Padding}"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     Focusable="True"
                                     Visibility="Collapsed" />
                            <Path Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{StaticResource MutedBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  IsHitTestVisible="False" />
                            <ToggleButton x:Name="ToggleFull"
                                          Style="{StaticResource ComboBoxHitTarget}"
                                          Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ToggleButton x:Name="ToggleArrow"
                                          Style="{StaticResource ComboBoxHitTarget}"
                                          Grid.Column="1"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Visibility="Collapsed"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ToggleFull" Property="IsHitTestVisible" Value="False" />
                                <Setter TargetName="ToggleArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource HighlightSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource BlueBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource OnBrandTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 变更集 138（UI 统一 I）：统一键盘焦点框——虚线描边 + 2px 外扩，深色主题下也可见 -->
        <Style x:Key="AppFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="1"
                                   Stroke="{StaticResource BlueBrush}"
                                   StrokeThickness="2"
                                   StrokeDashArray="1 1"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============================================================================
             图标几何注册表（变更集 147）。
             来源：Tabler Icons v3.46.0（MIT License，Copyright (c) 2020-2026 Paweł Kuna）
             出处/版本/许可全文：docs/THIRD-PARTY-NOTICES.md
             用法：<controls:UiIcon Kind="Play" Size="18" />（一律走 UiIcon，不在 XAML 里写裸字形）
             几何坐标系：24 x 24 描边路径（stroke-width 2）；笔画粗细由 UiIcon 按 Size/12 设置。
             注意：Tabler 图标带一条 24x24 画布边框路径（M0 0h24v24H0z，用于对齐）；本注册表已剔除，
             否则描边后会画出多余方框（2026-09-13 识图发现后修正）。
             ============================================================================ -->
        <GeometryGroup x:Key="Icon.Activity">
            <PathGeometry Figures="M3 12h4l3 8l4 -16l3 8h4" />
        </GeometryGroup>
        <GeometryGroup x:Key="Icon.Agent">
