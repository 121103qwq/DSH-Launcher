<Application x:Class="DshLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
        <SolidColorBrush x:Key="BlueBrush" Color="#1778D5" />
        <SolidColorBrush x:Key="BlueDarkBrush" Color="#0E5FAF" />
        <SolidColorBrush x:Key="PageBrush" Color="#EEF5FD" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#26384A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#718196" />
        <SolidColorBrush x:Key="LineBrush" Color="#D7E4F2" />

        <!-- DeepSea Glass design tokens. These keyed resources are additive so the
             existing implicit control styles and legacy resources stay compatible. -->
        <Color x:Key="DeepSeaBlueColor">#102A4A</Color>
        <Color x:Key="DeepSeaElectricCyanColor">#62F5EA</Color>
        <Color x:Key="DeepSeaLightPurpleColor">#B79CFF</Color>
        <Color x:Key="DeepSeaBackgroundColor">#071526</Color>
        <Color x:Key="DeepSeaPageSurfaceColor">#0D213A</Color>
        <Color x:Key="DeepSeaGlassSurfaceColor">#CC112A47</Color>
        <Color x:Key="DeepSeaGlassElevatedColor">#E0183859</Color>
        <Color x:Key="DeepSeaGlassFloatingColor">#F0204568</Color>
        <Color x:Key="DeepSeaApplicationFallbackColor">#FF0B1E33</Color>
        <Color x:Key="DeepSeaBackdropTintColor">#9A17324F</Color>
        <Color x:Key="DeepSeaTextColor">#F1F7FF</Color>
        <Color x:Key="DeepSeaMutedTextColor">#A9BCD2</Color>
        <Color x:Key="DeepSeaBorderColor">#66456A87</Color>
        <Color x:Key="DeepSeaSuccessColor">#4DDBA5</Color>
        <Color x:Key="DeepSeaWarningColor">#F5C86D</Color>
        <Color x:Key="DeepSeaErrorColor">#FF7189</Color>
        <Color x:Key="DeepSeaPrimarySurfaceColor">#FF087D9A</Color>
        <Color x:Key="DeepSeaPrimaryHoverColor">#FF0A9DBB</Color>
        <Color x:Key="DeepSeaDangerSurfaceColor">#A83C203B</Color>
        <Color x:Key="DeepSeaDangerHoverColor">#C94A2745</Color>

        <SolidColorBrush x:Key="DeepSeaBlueBrush" Color="{StaticResource DeepSeaBlueColor}" />
        <SolidColorBrush x:Key="DeepSeaElectricCyanBrush" Color="{StaticResource DeepSeaElectricCyanColor}" />
        <SolidColorBrush x:Key="DeepSeaLightPurpleBrush" Color="{StaticResource DeepSeaLightPurpleColor}" />
        <SolidColorBrush x:Key="DeepSeaBackgroundBrush" Color="{StaticResource DeepSeaBackgroundColor}" />
        <SolidColorBrush x:Key="DeepSeaPageSurfaceBrush" Color="{StaticResource DeepSeaPageSurfaceColor}" />
        <SolidColorBrush x:Key="DeepSeaGlassSurfaceBrush" Color="{StaticResource DeepSeaGlassSurfaceColor}" />
        <SolidColorBrush x:Key="DeepSeaGlassElevatedBrush" Color="{StaticResource DeepSeaGlassElevatedColor}" />
        <SolidColorBrush x:Key="DeepSeaGlassFloatingBrush" Color="{StaticResource DeepSeaGlassFloatingColor}" />
        <SolidColorBrush x:Key="DeepSeaSurfaceBrush" Color="{StaticResource DeepSeaGlassSurfaceColor}" />
        <SolidColorBrush x:Key="DeepSeaElevatedSurfaceBrush" Color="{StaticResource DeepSeaGlassElevatedColor}" />
        <SolidColorBrush x:Key="DeepSeaFloatingSurfaceBrush" Color="{StaticResource DeepSeaGlassFloatingColor}" />
        <SolidColorBrush x:Key="DeepSeaApplicationFallbackBrush" Color="{StaticResource DeepSeaApplicationFallbackColor}" />
        <SolidColorBrush x:Key="DeepSeaBackdropTintBrush" Color="{StaticResource DeepSeaBackdropTintColor}" />
        <SolidColorBrush x:Key="DeepSeaTextBrush" Color="{StaticResource DeepSeaTextColor}" />
        <SolidColorBrush x:Key="DeepSeaPrimaryTextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="DeepSeaMutedTextBrush" Color="{StaticResource DeepSeaMutedTextColor}" />
        <SolidColorBrush x:Key="DeepSeaBorderBrush" Color="{StaticResource DeepSeaBorderColor}" />
        <SolidColorBrush x:Key="DeepSeaSuccessBrush" Color="{StaticResource DeepSeaSuccessColor}" />
        <SolidColorBrush x:Key="DeepSeaWarningBrush" Color="{StaticResource DeepSeaWarningColor}" />
        <SolidColorBrush x:Key="DeepSeaErrorBrush" Color="{StaticResource DeepSeaErrorColor}" />
        <SolidColorBrush x:Key="DeepSeaPrimarySurfaceBrush" Color="{StaticResource DeepSeaPrimarySurfaceColor}" />
        <SolidColorBrush x:Key="DeepSeaPrimaryHoverBrush" Color="{StaticResource DeepSeaPrimaryHoverColor}" />
        <SolidColorBrush x:Key="DeepSeaDangerSurfaceBrush" Color="{StaticResource DeepSeaDangerSurfaceColor}" />
        <SolidColorBrush x:Key="DeepSeaDangerHoverBrush" Color="{StaticResource DeepSeaDangerHoverColor}" />
        <SolidColorBrush x:Key="DeepSeaNavHoverBrush" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="DeepSeaNavPressedBrush" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="DeepSeaNavBorderBrush" Color="#66FFFFFF" />

        <LinearGradientBrush x:Key="DeepSeaGradientBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B862F5EA" Offset="0" />
            <GradientStop Color="#7AB79CFF" Offset="0.52" />
            <GradientStop Color="#66456A87" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DeepSeaTopHighlightBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#BFFFFFFF" Offset="0" />
            <GradientStop Color="#45FFFFFF" Offset="0.42" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DeepSeaBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF071526" Offset="0" />
            <GradientStop Color="#FF102A4A" Offset="0.62" />
            <GradientStop Color="#FF251E4B" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="DeepSeaCardShadow"
                          Color="#E6000816"
                          BlurRadius="22"
                          ShadowDepth="2"
                          Opacity="0.24"
                          RenderingBias="Performance" />
        <CornerRadius x:Key="DeepSeaCornerRadiusSmall">8</CornerRadius>
        <CornerRadius x:Key="DeepSeaCornerRadiusMedium">12</CornerRadius>
        <CornerRadius x:Key="DeepSeaCornerRadiusLarge">16</CornerRadius>
        <CornerRadius x:Key="DeepSeaCornerRadius">16</CornerRadius>
        <Thickness x:Key="DeepSeaGlassBorderThickness">1</Thickness>
        <Duration x:Key="DeepSeaMotionDurationFast">0:0:0.12</Duration>
        <Duration x:Key="DeepSeaMotionDurationShort">0:0:0.14</Duration>
        <Duration x:Key="DeepSeaMotionDurationMedium">0:0:0.18</Duration>
        <Duration x:Key="DeepSeaMotionDurationLong">0:0:0.24</Duration>
        <Duration x:Key="DeepSeaMotionDuration">0:0:0.18</Duration>

        <Style x:Key="DeepSeaFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Grid>
                            <Rectangle Margin="1"
                                       RadiusX="9"
                                       RadiusY="9"
                                       Stroke="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                       StrokeThickness="2"
                                       SnapsToDevicePixels="True" />
                            <Rectangle Margin="3"
                                       RadiusX="7"
                                       RadiusY="7"
                                       Stroke="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                       StrokeThickness="1"
                                       SnapsToDevicePixels="True" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeepSeaGlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DeepSeaGlassSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DeepSeaGradientBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource DeepSeaGlassBorderThickness}" />
            <Setter Property="CornerRadius" Value="{StaticResource DeepSeaCornerRadiusLarge}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect" Value="{StaticResource DeepSeaCardShadow}" />
        </Style>

        <Style x:Key="DeepSeaButtonBase" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DeepSeaFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeepSeaButton" TargetType="Button" BasedOn="{StaticResource DeepSeaButtonBase}">
            <Setter Property="Background" Value="{StaticResource DeepSeaGlassSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DeepSeaGradientBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaGlassElevatedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaTopHighlightBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DeepSeaElectricCyanBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaGlassFloatingBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaElectricCyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeepSeaPrimaryButton" TargetType="Button" BasedOn="{StaticResource DeepSeaButton}">
            <Setter Property="Background" Value="{StaticResource DeepSeaPrimarySurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DeepSeaElectricCyanBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DeepSeaPrimaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaPrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaElectricCyanBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DeepSeaPrimaryTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaPrimarySurfaceBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeepSeaDangerButton" TargetType="Button" BasedOn="{StaticResource DeepSeaButton}">
            <Setter Property="Background" Value="{StaticResource DeepSeaDangerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DeepSeaErrorBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaDangerHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaErrorBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaDangerSurfaceBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeepSeaTertiaryButton" TargetType="Button" BasedOn="{StaticResource DeepSeaButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DeepSeaMutedTextBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaNavHoverBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaNavPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeepSeaStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DeepSeaGlassElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DeepSeaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource DeepSeaCornerRadiusSmall}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="DeepSeaInstanceItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DeepSeaFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{StaticResource DeepSeaGlassSurfaceBrush}"
                                BorderBrush="{StaticResource DeepSeaBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource DeepSeaCornerRadiusMedium}"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource DeepSeaGlassElevatedBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource DeepSeaTopHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource DeepSeaGlassFloatingBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource DeepSeaElectricCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource DeepSeaNavPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="ItemChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeepSeaWindowButton" TargetType="Button" BasedOn="{StaticResource DeepSeaButtonBase}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaNavHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaNavBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DeepSeaElectricCyanBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaNavPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeepSeaCloseButton" TargetType="Button" BasedOn="{StaticResource DeepSeaWindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaDangerHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaErrorBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaDangerSurfaceBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ContextInstanceMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxHeight" Value="410" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource DeepSeaGlassFloatingBrush}"
                                BorderBrush="{StaticResource DeepSeaGradientBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContextInstanceMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DeepSeaFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource DeepSeaNavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource DeepSeaGlassElevatedBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource DeepSeaElectricCyanBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter TargetName="ItemChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C5D5E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DeepSeaFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E7F1FC" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="#B8DCF8" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxHitTarget" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DeepSeaFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Chrome"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <ContentPresenter x:Name="SelectionPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="{TemplateBinding Padding}"
                                     Padding="0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     Focusable="True"
                                     Visibility="Collapsed" />
                            <Path Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{StaticResource MutedBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  IsHitTestVisible="False" />
                            <ToggleButton x:Name="ToggleFull"
                                          Style="{StaticResource ComboBoxHitTarget}"
                                          Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ToggleButton x:Name="ToggleArrow"
                                          Style="{StaticResource ComboBoxHitTarget}"
                                          Grid.Column="1"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Visibility="Collapsed"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ToggleFull" Property="IsHitTestVisible" Value="False" />
                                <Setter TargetName="ToggleArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DeepSeaFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E3F0FD" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#E7F1FC" />
                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#F7FAFD" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource BlueBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BlueDarkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="FontSize" Value="15" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F0FD" />
                    <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TopNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DeepSeaFocusVisualStyle}" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="3,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaNavHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaNavBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DeepSeaTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource DeepSeaNavPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaElectricCyanBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource DeepSeaElectricCyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
