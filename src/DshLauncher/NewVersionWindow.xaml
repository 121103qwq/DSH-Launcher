<Window x:Class="DshLauncher.NewVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建干净版本"
        Width="430"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="新建干净版本" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="版本名称" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Height="36" Padding="10,6" MaxLength="80" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="DSh 版本" Margin="0,0,0,6" />
            <ComboBox x:Name="VersionBox" Height="36" Padding="8,4" />
            <TextBlock Text="本机没有所选版本时，会从 @deepseek-ai/dsh 官方 npm 包下载到设置的 DSh 安装位置。"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
            <Button Content="创建" IsDefault="True" Click="Create_Click" Style="{StaticResource PrimaryButton}" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
