<Window x:Class="DshLauncher.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对话管理"
        Width="1080"
        Height="720"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="对话管理" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="InstanceText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,20,0,14">
            <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" />
            <Button Content="打开选中对话" Click="Open_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="导入 session.jsonl" Click="Import_Click" Margin="0,0,8,0" />
            <Button Content="导出选中对话" Click="Export_Click" Margin="0,0,8,0" />
            <Button Content="备份选中对话" Click="Backup_Click" Margin="0,0,8,0" />
            <Button Content="删除选中对话" Click="Delete_Click" />
        </WrapPanel>
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Background="White" Padding="8">
            <ListView x:Name="ConversationList" BorderThickness="0" SelectionChanged="ConversationList_SelectionChanged">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="会话 ID" Width="220" DisplayMemberBinding="{Binding SessionId}" />
                        <GridViewColumn Header="工作目录" Width="280" DisplayMemberBinding="{Binding WorkingDirectory}" />
                        <GridViewColumn Header="更新时间" Width="180" DisplayMemberBinding="{Binding UpdatedAt}" />
                        <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeBytes}" />
                        <GridViewColumn Header="格式" Width="100" DisplayMemberBinding="{Binding IsCompressed}" />
                        <GridViewColumn Header="路径" Width="360" DisplayMemberBinding="{Binding RelativePath}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
    </Grid>
</Window>
