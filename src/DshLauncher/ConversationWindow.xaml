<UserControl x:Class="DshLauncher.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Loaded="Window_OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,14">
            <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" />
            <Button Content="打开选中对话" Click="Open_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="导入 session.jsonl / .zstd" Click="Import_Click" Margin="0,0,8,0" />
            <Button Content="导出选中对话" Click="Export_Click" Margin="0,0,8,0" />
            <Button Content="备份选中对话" Click="Backup_Click" Margin="0,0,8,0" />
            <Button Content="删除选中对话" Click="Delete_Click" />
        </WrapPanel>
        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Background="White" Padding="8">
            <ListView x:Name="ConversationList" BorderThickness="0" SelectionChanged="ConversationList_SelectionChanged" MouseDoubleClick="ConversationList_MouseDoubleClick">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="会话 ID" Width="220" DisplayMemberBinding="{Binding SessionId}" />
                        <GridViewColumn Header="工作目录" Width="280" DisplayMemberBinding="{Binding WorkingDirectory}" />
                        <GridViewColumn Header="更新时间" Width="180" DisplayMemberBinding="{Binding UpdatedAt}" />
                        <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeBytes}" />
                        <GridViewColumn Header="格式" Width="100" DisplayMemberBinding="{Binding IsCompressed}" />
                        <GridViewColumn Header="路径" Width="360" DisplayMemberBinding="{Binding RelativePath}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="{StaticResource BlueBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
    </Grid>
    </ScrollViewer>
</UserControl>
