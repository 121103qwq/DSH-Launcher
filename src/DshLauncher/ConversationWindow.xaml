<UserControl x:Class="DshLauncher.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Loaded="Window_OnLoaded">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="240" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="版本"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      x:Name="VersionSelectorBox"
                      Height="38"
                      DisplayMemberPath="Name"
                      SelectionChanged="VersionSelector_SelectionChanged" />
            <TextBlock Grid.Column="3"
                       Text="显示"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox Grid.Column="4"
                      x:Name="ConversationScopeBox"
                      Height="38"
                      SelectedIndex="0"
                      SelectionChanged="ConversationScope_SelectionChanged">
                <ComboBoxItem Tag="All">全部对话</ComboBoxItem>
                <ComboBoxItem Tag="Isolated">隔离对话</ComboBoxItem>
                <ComboBoxItem Tag="Workspace">工作区对话</ComboBoxItem>
            </ComboBox>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="对话文件">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,14">
                        <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" />
                        <Button Content="打开选中对话" Click="Open_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="导入 session.jsonl / .zstd" Click="Import_Click" Margin="0,0,8,0" />
                        <Button Content="导出选中对话" Click="Export_Click" Margin="0,0,8,0" />
                        <Button Content="备份选中对话" Click="Backup_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DangerButton}" Content="删除选中对话" Click="Delete_Click" />
                    </WrapPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 ToolTip="搜索所有实例的会话内容（正文、标题、工作区）；压缩的 session.jsonl.zstd 也会解压搜索"
                                 KeyDown="SearchBox_KeyDown" />
                        <Button x:Name="SearchButton"
                                Grid.Column="1"
                                Content="搜索"
                                Click="Search_Click"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" />
                        <Button x:Name="ClearSearchButton"
                                Grid.Column="2"
                                Content="退出搜索"
                                Click="ClearSearch_Click"
                                Visibility="Collapsed"
                                Margin="8,0,0,0" />
                    </Grid>
                    <Border Grid.Row="2"
                            x:Name="SearchResultsPanel"
                            Visibility="Collapsed"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            Background="White"
                            Padding="8"
                            ClipToBounds="True">
                        <ListView x:Name="SearchResultsList"
                                  BorderThickness="0"
                                  MouseDoubleClick="SearchResultsList_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" >
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="名称" Width="220" DisplayMemberBinding="{Binding Entry.DisplayName}" />
                                    <GridViewColumn Header="工作区" Width="200" DisplayMemberBinding="{Binding Entry.WorkingDirectory}" />
                                    <GridViewColumn Header="命中片段" Width="420" DisplayMemberBinding="{Binding Snippet}" />
                                    <GridViewColumn Header="命中" Width="60" DisplayMemberBinding="{Binding MatchCount}" />
                                    <GridViewColumn Header="实例" Width="160" DisplayMemberBinding="{Binding Entry.InstanceName}" />
                                    <GridViewColumn Header="更新时间" Width="150" DisplayMemberBinding="{Binding Entry.UpdatedAt}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <Border Grid.Row="2"
                            x:Name="ConversationListPanel"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            Background="White"
                            Padding="8"
                            ClipToBounds="True">
                        <ListView x:Name="ConversationList"
                                  BorderThickness="0"
                                  SelectionChanged="ConversationList_SelectionChanged"
                                  MouseDoubleClick="ConversationList_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" >
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="名称" Width="240" DisplayMemberBinding="{Binding DisplayName}" />
                                    <GridViewColumn Header="实例" Width="180" DisplayMemberBinding="{Binding InstanceName}" />
                                    <GridViewColumn Header="更新时间" Width="160" DisplayMemberBinding="{Binding UpdatedAt}" />
                                    <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeBytes}" />
                                    <GridViewColumn Header="格式" Width="90" DisplayMemberBinding="{Binding IsCompressed}" />
                                    <GridViewColumn Header="代际" Width="150" DisplayMemberBinding="{Binding GenerationText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="备份与恢复">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="刷新备份" Click="RefreshBackups_Click" Margin="0,0,8,0" />
                        <Button Content="恢复选中备份"
                                Click="RestoreBackup_Click"
                                Style="{StaticResource PrimaryButton}" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1"
                               Text="恢复会把备份重新放回当前实例；已有相同会话 ID 时不会覆盖。实例运行时不能恢复。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            Background="White"
                            Padding="8"
                            ClipToBounds="True">
                        <ListView x:Name="BackupList"
                                  BorderThickness="0"
                                  SelectionChanged="BackupList_SelectionChanged"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" >
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="名称" Width="260" DisplayMemberBinding="{Binding DisplayName}" />
                                    <GridViewColumn Header="备份时间" Width="160" DisplayMemberBinding="{Binding BackedUpAt}" />
                                    <GridViewColumn Header="实例" Width="170" DisplayMemberBinding="{Binding InstanceName}" />
                                    <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeBytes}" />
                                    <GridViewColumn Header="备份文件" Width="260" DisplayMemberBinding="{Binding FileName}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Foreground="{StaticResource BlueBrush}"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0" />
    </Grid>
</UserControl>
