<UserControl x:Class="DshLauncher.EnvironmentScanWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Loaded="Window_OnLoaded"
             Unloaded="Window_OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="扫描本机 DSH 环境" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="枚举 %USERPROFILE%\.dsh* 与 DSH_HOME 环境变量指向的 home；勾选后按 home 建实例（一个 home 一个实例，只支持带 profiles/web 的 home）。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="重新扫描" Click="Rescan_Click" Padding="12,7" Margin="0,0,7,0" />
                        <Button Content="返回版本控制" Click="Back_Click" Padding="12,7" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="导入到版本：" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox x:Name="TemplateCombo"
                              Width="260"
                              Height="30"
                              Margin="7,0,0,0"
                              DisplayMemberPath="Name"
                              ToolTip="新实例复用该版本的 DSh 运行目录与启动方式" />
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" />
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="{StaticResource CardPadding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="WarningPanel"
                            Background="{StaticResource WarningBackgroundBrush}"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ItemCornerRadius}"
                            Padding="10,7"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <TextBlock x:Name="WarningText"
                                   Foreground="{StaticResource WarningTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl x:Name="HomeList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ItemCornerRadius}"
                                                Padding="12,10"
                                                Margin="{StaticResource ItemMargin}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanSelect}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                    <Border Background="{StaticResource PageBrush}"
                                                            BorderBrush="{StaticResource BlueBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding SourceText}"
                                                                   Foreground="{StaticResource BlueDarkBrush}"
                                                                   FontSize="11" />
                                                    </Border>
                                                    <Border Background="{StaticResource NeutralSurfaceBrush}"
                                                            BorderBrush="{StaticResource LineBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="6,1"
                                                            Margin="6,0,0,0"
                                                            Visibility="{Binding RegisteredVisibility}">
                                                        <TextBlock Text="已登记"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding PathText}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="28,4,0,0" />
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,6,0,0">
                                                    <ItemsControl ItemsSource="{Binding Profiles}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource InfoBackgroundBrush}"
                                                                        BorderBrush="{StaticResource LineBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3"
                                                                        Padding="6,1"
                                                                        Margin="0,0,6,0">
                                                                    <TextBlock FontSize="11" Foreground="{Binding KindBrush}">
                                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                                        <Run Text=" · " />
                                                                        <Run Text="{Binding KindText, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding HintText}"
                                                               Foreground="{StaticResource DangerTextBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,0,0"
                                                               Visibility="{Binding HintVisibility}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyText"
                                       Text="没有扫描到可导入的 DSH home。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="ImportButton"
                                Content="导入选中"
                                Click="Import_Click"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,8" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
