<UserControl x:Class="DshLauncher.VersionSettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DshLauncher.Controls"
             FontFamily="{StaticResource UiFont}"
             Loaded="Window_OnLoaded"
             Unloaded="Window_OnUnloaded">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <!-- 阴影单独一层：避免 DropShadowEffect 把导航文字一起栅格化 -->
            <!-- 变更集 121：左栏统一为应用标准圆角卡（CardCornerRadius=12），与扩展 / 版本控制 / 设置·诊断页一致 -->
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Effect="{StaticResource CardShadowSoft}" />
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="10,18">
            <StackPanel>
                <TextBlock x:Name="VersionSettingsHeaderText"
                           Text="版本设置"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="10,0,10,4" />
                <TextBlock x:Name="VersionIdentityText"
                           Text="当前版本"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Margin="10,0,10,18" />

                <Button x:Name="PersonalizationButton"
                        Content="▣   个性化"
                        Click="Personalization_Click"
                        Style="{StaticResource NavButton}" />
                <Button x:Name="ConfigurationButton"
                        Content="⚙   配置"
                        Click="Configuration_Click"
                        Style="{StaticResource NavButton}" />
                <Button x:Name="PluginsButton"
                        Content="♧   插件管理"
                        Click="Plugins_Click"
                        Style="{StaticResource NavButton}" />
                <Button x:Name="HealthButton"
                        Content="◎   运行状况"
                        Click="Health_Click"
                        Style="{StaticResource NavButton}" />
                <Button x:Name="ExportButton"
                        Content="⇧   导出"
                        Click="Export_Click"
                        Style="{StaticResource NavButton}" />
            </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <StackPanel Margin="18">
                <TextBlock x:Name="PageHeaderText"
                           Text="个性化"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="PageDescriptionText"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,18" />

                <StackPanel x:Name="PersonalizationPage">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="当前版本" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="PersonalizationVersionText"
                                       Foreground="{StaticResource BlueBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,0" />
                            <TextBlock x:Name="PersonalizationDetailsText"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="版本名称"
                                       FontWeight="SemiBold"
                                       Margin="0,20,0,0" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VersionNameBox"
                                         MaxLength="80"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="保存名称"
                                        Click="SaveVersionName_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="PersonalizationStatusText"
                                       Foreground="{StaticResource BlueBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <Border Background="{StaticResource InfoBackgroundBrush}" CornerRadius="{StaticResource PanelCornerRadius}" Padding="{StaticResource CardPadding}" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="版本数据位置" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DshHomeText"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="每个版本使用独立 DSH_HOME；这里不直接复制 DSh 运行程序。"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource InfoBackgroundBrush}"
                                    CornerRadius="{StaticResource PanelCornerRadius}"
                                    Padding="{StaticResource CardPadding}"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="实例环境变量" FontWeight="SemiBold" />
                                    <TextBlock Text="启动这个实例时注入进程环境；DSH_HOME / DSH_AGENTS_HOME / PATH 由 Launcher 管理，不能覆盖。含 KEY / TOKEN / SECRET / PASSWORD 等敏感值会用当前 Windows 账户加密后落盘，诊断包不包含变量值。"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <StackPanel x:Name="EnvironmentVariableList" Margin="0,12,0,0" />
                                    <Button Content="添加变量"
                                            Click="AddEnvironmentVariable_Click"
                                            HorizontalAlignment="Left"
                                            Margin="0,2,0,0" />
                                    <TextBlock x:Name="EnvironmentVariableStatusText"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                    <Button Content="保存环境变量"
                                            Click="SaveEnvironmentVariables_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="TerminalCommandCard"
                                    Background="{StaticResource InfoBackgroundBrush}"
                                    CornerRadius="{StaticResource PanelCornerRadius}"
                                    Padding="{StaticResource CardPadding}"
                                    Margin="0,14,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="终端启动（TUI 插件）" FontWeight="SemiBold" />
                                    <TextBlock Text="该实例扫到 TUI 插件（如 dsh-tui）。TUI 不由启动器托管，请在终端里执行下面的命令：已带上 DSH_HOME 与活动 profile，直接粘进 PowerShell 即可；实例正在运行时可先停止。"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                    <TextBlock x:Name="TerminalInstallLabel"
                                               Text="① 安装 / 升级插件（首次或换机时）"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,0" />
                                    <TextBox x:Name="TerminalInstallCommandBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Height="46"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,4,0,0" />
                                    <Button x:Name="CopyTerminalInstallButton"
                                            Content="复制安装命令"
                                            Tag="install"
                                            Click="CopyTerminalCommand_Click"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0" />

                                    <TextBlock Text="② 启动新会话"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,0" />
                                    <TextBox x:Name="TerminalCommandBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Height="46"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,4,0,0" />
                                    <Button Content="复制启动命令"
                                            Tag="new"
                                            Click="CopyTerminalCommand_Click"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0" />

                                    <TextBlock Text="③ 继续上次会话（--continue）"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,0" />
                                    <TextBox x:Name="TerminalContinueCommandBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Height="46"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,4,0,0" />
                                    <Button Content="复制续接命令"
                                            Tag="continue"
                                            Click="CopyTerminalCommand_Click"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0" />

                                    <TextBlock x:Name="TerminalCommandHintText"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ConfigurationPage" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20">
                        <StackPanel>
                            <CheckBox x:Name="SyncAllConfigurationCheckBox"
                                      Content="和所有版本配置同步"
                                      FontSize="15"
                                      FontWeight="SemiBold"
                                      Checked="SyncAllConfiguration_Changed"
                                      Unchecked="SyncAllConfiguration_Changed" />
                            <TextBlock Text="打开后，下面的对话文件同步选项会跟随所有版本，不能单独修改。模型同步由下面的独立开关控制。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,6,0,16" />

                            <StackPanel x:Name="ConfigurationOptionsPanel">
                                <TextBlock Text="对话文件同步" FontWeight="SemiBold" />
                                <RadioButton x:Name="ConversationIndependentRadio"
                                             Content="该版本完全独立"
                                             GroupName="ConversationSync"
                                             Margin="0,10,0,0"
                                             Checked="ConversationMode_Changed" />
                                <RadioButton x:Name="ConversationWorkspaceRadio"
                                             Content="按工作区同步"
                                             GroupName="ConversationSync"
                                             Margin="0,8,0,0"
                                             Checked="ConversationMode_Changed" />
                                <ComboBox x:Name="ConversationWorkspaceBox"
                                          IsEditable="True"
                                          Height="36"
                                          Margin="24,7,0,0"
                                          ToolTip="选择已有工作区，或输入新的工作区名称" />
                                <RadioButton x:Name="ConversationAllRadio"
                                             Content="全量同步（所有工作区和所有版本）"
                                             GroupName="ConversationSync"
                                             Margin="0,10,0,0"
                                             Checked="ConversationMode_Changed" />
                            </StackPanel>
                            <CheckBox x:Name="SyncModelProvidersCheckBox"
                                      Content="所有版本自动同步模型"
                                      Margin="0,18,0,0" />
                            <TextBlock Text="开启后，模型提供商配置不受对话文件的独立、工作区、全量或全配置同步选择影响。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,6,0,0" />
                            <Button Content="保存配置"
                                    Click="SaveConfiguration_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,20,0,0" />
                            <TextBlock x:Name="ConfigurationStatusText"
                                       Foreground="{StaticResource BlueBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PluginPage" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="已安装 Plugin" FontSize="16" FontWeight="SemiBold" />
                                <Button Content="刷新"
                                        Click="RefreshPlugins_Click"
                                        DockPanel.Dock="Right"
                                        Padding="14,6" />
                            </DockPanel>
                            <TextBlock x:Name="PluginEmptyText"
                                       Text="当前版本没有检测到已安装 Plugin。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0" />
                            <ListBox x:Name="PluginList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Margin="0,12,0,0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InfoBackgroundBrush}" CornerRadius="9" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Version, TargetNullValue=版本未标记}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11"
                                                               Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Description, TargetNullValue=没有描述}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="启用"
                                                            Tag="{Binding}"
                                                            Click="PluginToggle_Click"
                                                            IsEnabled="{Binding Managed}"
                                                            Padding="10,6" />
                                                    <Button Content="禁用"
                                                            Tag="{Binding}"
                                                            Click="PluginToggle_Click"
                                                            IsEnabled="{Binding Managed}"
                                                            Padding="10,6"
                                                            Margin="6,0,0,0" />
                                                    <Button Content="删除"
                                                            Tag="{Binding}"
                                                            Click="PluginDelete_Click"
                                                            IsEnabled="{Binding Managed}"
                                                            Padding="10,6"
                                                            Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="PluginStatusText"
                                       Foreground="{StaticResource BlueBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="窗口与运行环境" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="这些设置只对当前版本生效。Node.js 仍由 Launcher 检测和调用，不会被内置到 Launcher。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,6,0,14" />
                            <TextBlock Text="自定义窗口标题" FontWeight="SemiBold" />
                            <TextBox x:Name="WindowTitleBox" Margin="0,7,0,14" />
                            <TextBlock Text="Node.js 可执行文件" FontWeight="SemiBold" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NodePathBox" />
                                <Button Grid.Column="1" Content="浏览…" Click="BrowseNode_Click" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="NodeRuntimeText"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,8,0,0" />
                            <Button Content="保存窗口与 Node 设置"
                                    Click="SavePluginSettings_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>


                <StackPanel x:Name="ExportPage" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="导出版本整合包" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="导出用于分享版本设计，导入后会重新创建一个独立版本。"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,14" />
                            <CheckBox x:Name="IncludePluginConfigurationCheckBox"
                                      Content="包含当前版本的 Plugin 配置"
                                      IsChecked="True"
                                      Margin="0,0,0,10" />
                            <CheckBox x:Name="IncludeSessionsCheckBox"
                                      Content="会话文件（禁止导出）"
                                      IsChecked="False"
                                      IsEnabled="False"
                                      Margin="0,0,0,14" />
                            <Border Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                                <TextBlock Text="不会导出 API Key、Token、密码、环境变量值、sessions/会话文件，也不导出模型提供商配置。"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11" />
                            </Border>
                            <Button Content="导出为压缩包"
                                    Click="ExportPackage_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,18,0,0" />
                            <Button Content="导出为整合包（.dspack v4）"
                                    Click="ExportPackV4_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    ToolTip="按 DSH 整合包规范 manifest v4 + .dspack（pack-structure v2）导出当前 profile：含 bundles、依赖坐标、patch 与 pnpm 锁文件；可被社区整合包工具导入" />
                            <TextBlock x:Name="ExportStatusText"
                                       Foreground="{StaticResource BlueBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="整合包格式" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="版本控制中的导入会识别这个扩展名；包本身仍是 ZIP 结构。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PackageExtensionBox" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="保存格式" Click="SavePackageExtension_Click" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="HealthPage" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="运行概况" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="HealthSummaryText"
                                       Foreground="{StaticResource BlueBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                            <TextBlock x:Name="HealthDetailText"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="刷新" Click="RefreshHealth_Click" Margin="0,0,8,8" />
                                <CheckBox x:Name="HealthAutoRefreshCheckBox"
                                          Content="自动刷新（1 秒）"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,8" />
                                <Button Content="清空日志" Click="ClearHealthLog_Click" Margin="0,0,8,8" />
                                <Button Content="复制日志" Click="CopyHealthLog_Click" Margin="0,0,8,8" />
                                <Button Content="清理残留进程"
                                        Click="CleanupHealth_Click"
                                        Style="{StaticResource DangerButton}"
                                        ToolTip="清理该实例的残留进程（桌宠、插件市场 helper、上次异常退出的旧进程等）；实例运行中时保留当前 dsh 主进程。"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="HealthActionText"
                                       Foreground="{StaticResource BlueBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="空闲自动停止" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="开启后，实例长时间没有活动（无 CPU、无外部连接、无会话写入、无日志输出）会自动停止，避免后台常驻占内存。存在后台任务（如正在等模型响应）时不会算空闲；Launcher 正在安装/更新时也不会停。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10" />
                            <CheckBox x:Name="AutoStopCheckBox"
                                      Content="空闲时自动停止该实例"
                                      VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="空闲阈值"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox x:Name="AutoStopMinutesBox" Width="150" Height="34" />
                            </StackPanel>
                            <TextBlock x:Name="AutoStopStatusText"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <Button Content="保存空闲设置"
                                    Click="SaveAutoStop_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="崩溃恢复" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="dsh 进程意外退出时怎么办。Launcher 主动停止（手动 / 空闲自动停止 / 安全模式切换 / 更新 / 退出启动器）不算崩溃；退避重启 5 秒 → 15 秒 → 1 分钟 → 5 分钟，稳定运行 10 分钟后再崩溃会重新计算次数。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="崩溃后行为"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox x:Name="CrashPolicyBox" Width="230" Height="34" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="自动重启上限"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox x:Name="CrashLimitBox" Width="150" Height="34" />
                            </StackPanel>
                            <TextBlock x:Name="CrashStatusText"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="保存崩溃设置"
                                        Click="SaveCrashPolicy_Click"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="ClearCooldownButton"
                                        Content="清冷却并重启"
                                        Click="ClearCooldown_Click"
                                        Visibility="Collapsed"
                                        Margin="10,0,0,0" />
                            </StackPanel>
                            <ListView x:Name="CrashRecordList"
                                      Height="140"
                                      Margin="0,14,0,0"
                                      BorderThickness="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding TimeText}" />
                                        <GridViewColumn Header="退出码" Width="70" DisplayMemberBinding="{Binding ExitText}" />
                                        <GridViewColumn Header="运行时长" Width="100" DisplayMemberBinding="{Binding UptimeText}" />
                                        <GridViewColumn Header="动作" Width="90" DisplayMemberBinding="{Binding Action}" />
                                        <GridViewColumn Header="原因" Width="120" DisplayMemberBinding="{Binding Cause}" />
                                        <GridViewColumn Header="摘要" Width="420" DisplayMemberBinding="{Binding Summary}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="资源占用（最近 20 分钟，每 5 秒一个采样点）" FontSize="16" FontWeight="SemiBold" />
                            <controls:MetricChart x:Name="HealthCpuChart" Height="120" Margin="0,12,0,0" />
                            <controls:MetricChart x:Name="HealthMemoryChart" Height="120" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="进程树" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Launcher 托管的 dsh 进程及其子进程（按内存降序）。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,6,0,10" />
                            <ListView x:Name="HealthProcessList"
                                      Height="150"
                                      BorderThickness="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding ProcessId}" />
                                        <GridViewColumn Header="进程" Width="160" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="内存" Width="110" DisplayMemberBinding="{Binding MemoryText}" />
                                        <GridViewColumn Header="累计 CPU" Width="110" DisplayMemberBinding="{Binding CpuText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="dsh 标准输出/错误与 Launcher 生命周期事件（只保留最近 2000 行，不落盘）。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,6,0,10" />
                            <TextBox x:Name="HealthLogBox"
                                     Height="220"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"
                                     FontFamily="Consolas, Cascadia Mono, monospace"
                                     FontSize="11"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="White"
                                     BorderBrush="{StaticResource LineBrush}"
                                     BorderThickness="1" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="插件排查" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="安全模式能启动、但不确定是哪个插件坏了时，用二分法定位：每轮在隔离 profile 里禁用一部分第三方插件后启动（不改你的任何文件），通常 2–4 轮就能锁定。定位结束会删掉隔离 profile。"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BisectButton"
                                        Content="定位肇事插件"
                                        Click="BisectPlugins_Click"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button x:Name="ProfileHygieneButton"
                                        Content="检查并复位 profile 残留"
                                        Click="ProfileHygiene_Click"
                                        Margin="8,0,0,0"
                                        ToolTip="检查 profile 里已卸载插件留下的残留（空的 pnpm-lock.yaml、allowBuilds 残留、缺 dependencies 键）；复位前自动快照，只动这三个配置文件" />
                                <Button x:Name="DisableCulpritButton"
                                        Content="禁用该插件并正常启动"
                                        Click="DisableCulprit_Click"
                                        Visibility="Collapsed"
                                        Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="BisectStatusText"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="20"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="启动证据" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,6,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最近 60 条启动判定与四层证据（进程 / 日志 / HTTP / 页面），最新的在最上面；同时落盘保留最近 200 条，重启 Launcher 后仍可回看。"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Button Grid.Column="1"
                                        Content="清空启动证据"
                                        Click="ClearStartupEvidence_Click"
                                        VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="HealthEvidenceList"
                                      Height="160"
                                      BorderThickness="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Header="时间" Width="90" DisplayMemberBinding="{Binding TimeText}" />
                                        <GridViewColumn Header="层" Width="70" DisplayMemberBinding="{Binding LayerText}" />
                                        <GridViewColumn Header="结论" Width="260" DisplayMemberBinding="{Binding Summary}" />
                                        <GridViewColumn Header="详情" Width="420" DisplayMemberBinding="{Binding Detail}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="VersionRequiredText"
                           Foreground="{StaticResource WarningTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
