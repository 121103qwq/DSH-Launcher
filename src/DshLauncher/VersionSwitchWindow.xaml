<Window SnapsToDevicePixels="True" UseLayoutRounding="True" x:Class="DshLauncher.VersionSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更换运行版本"
        Width="660"
        Height="680"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="更换运行版本" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="InstanceText"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="目标 DSh 版本" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TargetVersionBox" Height="36" Padding="8,4" SelectionChanged="TargetVersionBox_SelectionChanged" />
                <Button Grid.Column="1"
                        x:Name="RefreshButton"
                        Content="刷新列表"
                        Click="Refresh_Click"
                        Padding="12,7"
                        Margin="8,0,0,0" />
            </Grid>
            <TextBlock x:Name="TargetHintText"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <CheckBox x:Name="SnapshotBox"
                      Content="切换前创建配置快照（默认关闭；快照含设置/凭据引用/插件清单与锁文件，不含会话）"
                      Click="Option_Click" />
            <CheckBox x:Name="SessionBackupBox"
                      Content="导出现有会话备份（目标版本读不了这些会话时建议勾选）"
                      Click="Option_Click"
                      Visibility="Collapsed"
                      Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="3"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PanelCornerRadius}"
                Padding="14"
                Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ReportText"
                           TextWrapping="Wrap"
                           Text="选择目标版本后点「检查」：会校验本机/官方版本、Node 引擎、插件核心依赖与会话格式。"
                           Foreground="{StaticResource TextBrush}" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Foreground="{StaticResource BlueBrush}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <!-- 确认步骤用窗口内自绘面板，不用 MessageBox：可被 UIA 定点定位、无模态嵌套、
             还能把「勾选项/预检警告」与确认放在同一屏（work-log/54 B1）。 -->
        <Border x:Name="ConfirmPanel"
                Grid.Row="5"
                Background="{StaticResource InfoBackgroundBrush}"
                BorderBrush="{StaticResource BlueBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PanelCornerRadius}"
                Padding="14"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="确认更换运行版本" FontWeight="SemiBold" />
                <TextBlock x:Name="ConfirmText"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="ConfirmCancelButton"
                            Content="返回"
                            Click="ConfirmCancel_Click"
                            Padding="16,7"
                            Margin="0,0,8,0" />
                    <Button x:Name="ConfirmButton"
                            Content="确认切换"
                            Click="Confirm_Click"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,7" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
            <Button x:Name="CheckButton" Content="检查" Click="Check_Click" Padding="18,8" Margin="0,0,8,0" />
            <Button x:Name="SwitchButton"
                    Content="切换"
                    Click="Switch_Click"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButton}"
                    Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
