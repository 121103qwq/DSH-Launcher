<UserControl x:Class="DshLauncher.ModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Loaded="Window_OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">
            <TextBlock Text="模型与 Provider" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="InstanceText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="DeepSeek 官方 Provider" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="只保存 API 环境变量名，不读取或显示 API Key 明文。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,16" />
                    <TextBlock Text="API Key 环境变量" />
                    <TextBox x:Name="DeepSeekKey" Margin="0,5,0,12" />
                    <TextBlock Text="Base URL（可留空使用默认值）" />
                    <TextBox x:Name="DeepSeekBaseUrl" Margin="0,5,0,12" />
                    <TextBlock Text="模型 ID（逗号、分号或换行分隔）" />
                    <TextBox x:Name="DeepSeekModels" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="OpenAI-compatible Provider（可选）" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="对应 DSh 的 llm-pi-ai.providers 配置；已有其它 Provider 会保留。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Provider 名称" VerticalAlignment="Center" />
                        <TextBox x:Name="CompatibleProvider" Grid.Column="1" Margin="0,0,0,10" />
                        <TextBlock Text="API Key 环境变量" Grid.Row="1" VerticalAlignment="Center" />
                        <TextBox x:Name="CompatibleKey" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" />
                        <TextBlock Text="Base URL" Grid.Row="2" VerticalAlignment="Center" />
                        <TextBox x:Name="CompatibleBaseUrl" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" />
                        <TextBlock Text="模型 ID" Grid.Row="3" VerticalAlignment="Center" />
                        <TextBox x:Name="CompatibleModels" Grid.Row="3" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="读取当前配置" Click="Refresh_Click" Margin="0,0,10,0" />
                <Button Content="保存模型配置" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
