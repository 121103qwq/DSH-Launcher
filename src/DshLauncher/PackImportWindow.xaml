<Window x:Class="DshLauncher.PackImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入整合包"
        Width="680"
        Height="640"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="导入整合包（规范格式）" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="将创建的新实例" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="InstanceText" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="FilesText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="导入只新建独立实例，不覆盖任何现有版本。"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="包内文件清单" FontSize="12" FontWeight="SemiBold" />
                <ItemsControl x:Name="FileList" Margin="0,6,0,0" />
                <TextBlock x:Name="WarningText"
                           Foreground="{StaticResource WarningTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
                <TextBlock x:Name="DownloadText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />
                <ItemsControl x:Name="DownloadList" Margin="0,6,0,0" />
                <Border x:Name="DownloadConsentPanel"
                        Background="{StaticResource WarningBackgroundBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <CheckBox x:Name="AllowDownloadsCheck"
                                  Content="允许按包内声明的 https 地址下载这些文件（并强制 sha256 校验）"
                                  Checked="AllowDownloads_Changed"
                                  Unchecked="AllowDownloads_Changed" />
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="不勾选则无法导入（默认拒绝联网下载）。校验不通过会整体回滚，不留半成品。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Foreground="{StaticResource DangerTextBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Click="Cancel_Click"
                    IsCancel="True"
                    MinWidth="96" />
            <Button x:Name="ImportButton"
                    Content="导入"
                    Click="Import_Click"
                    IsDefault="True"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
