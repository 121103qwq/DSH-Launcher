<UserControl SnapsToDevicePixels="True" UseLayoutRounding="True" x:Class="DshLauncher.LogCenterWindow"
             xmlns:controls="clr-namespace:DshLauncher.Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Loaded="Window_OnLoaded"
             Unloaded="Window_OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                Padding="{StaticResource CardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <!-- 变更集 149：原来"文字"与"按钮行"叠在同一格 → 第 4 个按钮压住灰色说明文字。
                         改为两列：文字占 * 自行换行，按钮独占 Auto 列，永不重叠。 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="日志中心" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="只读浏览 Launcher 的结构化日志（launcher.log 及其轮转旧文件）：按天分组，可按级别 / 实例 / 关键字过滤。启动与停止事件带实例名、端口与 PID；错误行带错误码（E1xxx 环境 / E2xxx 插件 / E3xxx 网络 …）。删除日志请用「存储与清理」。"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- 变更集 151：四个按钮改为 2×2 Grid —— 两行**共享同一组 Auto 列**，
                         于是同一列的按钮同宽、左右边都对齐（150 的两行 StackPanel 各自右对齐，列边不齐）。 -->
                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="BackButton" Grid.Row="0" Grid.Column="0" Margin="0,0,7,0"
                                AutomationProperties.Name="返回设置" Click="Back_Click" Padding="12,7"><StackPanel Orientation="Horizontal"><controls:UiIcon Kind="ArrowLeft" Size="16" Margin="{StaticResource IconTextGap}" /><TextBlock Text="返回设置" /></StackPanel></Button>
                        <Button Grid.Row="0" Grid.Column="1" Content="刷新" Click="Refresh_Click" Padding="12,7" />
                        <Button Grid.Row="1" Grid.Column="0" Margin="0,7,7,0" Content="打开日志目录" Click="OpenFolder_Click" Padding="12,7" />
                        <!-- 变更集 148：一键清理日志（复用「存储与清理」的 crash / old-logs 分类；当前 launcher.log 不动） -->
                        <Button Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Style="{StaticResource DangerButton}" Content="清理日志" Click="CleanLogs_Click" Padding="12,7" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="级别" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="LevelBox" Width="96" Height="30" SelectionChanged="Filter_Changed" />
                    <TextBlock Text="实例" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <ComboBox x:Name="InstanceBox" Width="150" Height="30" SelectionChanged="Filter_Changed" />
                    <TextBox x:Name="KeywordBox"
                             Width="220"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Margin="14,0,0,0"
                             TextChanged="Keyword_Changed"
                             ToolTip="在消息 / 错误码 / 实例名里搜索（忽略大小写）" />
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" />
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="{StaticResource CardPadding}">
                <Grid>
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogPanel" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText"
                               Text="暂时没有匹配的日志。"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
